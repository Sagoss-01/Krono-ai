# --- PostgreSQL (Neon, Supabase, Railway, ou local) ---
# IMPORTANT : SQLAlchemy async a besoin du driver "asyncpg", pas "psycopg2".
# Si Neon/Supabase te donne "postgresql://...", change juste le début en
# "postgresql+asyncpg://..." comme ci-dessous.
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx-xxx.eu-central-1.aws.neon.tech/neondb

# --- JWT ---
# Génère une vraie valeur aléatoire avec : python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=colle_ici_une_chaine_aleatoire_longue

# --- Gemini ---
GEMINI_API_KEY=ta_cle_gemini

# --- OAuth2 (à remplir plus tard, pas nécessaire pour tester Gemini/Postgres) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- OpenRouter ---
OPENROUTER_API_KEY=sk-or-v1-xxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

