    { "src": "/logo-192.png",      "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/logo-512.png",      "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/logo-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
