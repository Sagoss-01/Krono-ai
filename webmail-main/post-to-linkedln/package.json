{
  "name": "techsphere-webmail",
  "version": "3.0.0",
  "description": "TechSphere Webmail — powered by netiify.cloud",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "tw:build": "npx tailwindcss -i ./public/css/input.css -o ./public/css/style.css --minify",
    "tw:watch": "npx tailwindcss -i ./public/css/input.css -o ./public/css/style.css --watch",
    "deploy:build": "npm install && npm run build:mediasoup-client && npm run tw:build",
    "build:mediasoup-client": "node scripts/build-mediasoup-client.mjs"
  },
  "dependencies": {
    "express": "^4.18.2",
    "imap": "^0.8.19",
    "nodemailer": "^6.9.7",
    "mailparser": "^3.6.5",
    "express-session": "^1.17.3",
    "socket.io": "^4.6.1",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.5",
    "uuid": "^9.0.0",
    "cookie-parser": "^1.4.6",
    "mediasoup": "^3.15.6",
    "mediasoup-client": "^3.15.6"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "tailwindcss": "^3.4.1",
    "daisyui": "^4.4.19",
    "esbuild": "^0.25.2"
  }
}
