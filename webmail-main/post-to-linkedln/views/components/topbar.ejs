<!-- views/components/topbar.ejs -->
<div class="topbar" id="topbar">
  <button class="icon-btn" onclick="App.toggleSidebar()" title="Menu">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
  </button>

  <a href="/" class="topbar-logo">
    <div class="logo-icon-sm">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="white"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
    </div>
    <span class="topbar-brand topbar-brand-hide-mobile">TechSphere <span style="opacity:.4;font-weight:400;">Mail</span></span>
  </a>

  <!-- Account switcher -->
  <div class="account-switcher" id="account-switcher">
    <button class="account-pill" onclick="App.toggleAccountMenu()" id="account-pill">
      <div class="pill-avatar" id="pill-avatar">?</div>
      <span class="pill-email" id="pill-email">—</span>
      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
    </button>

    <div class="account-menu" id="account-menu" style="display:none;">
      <div class="account-menu-header">Comptes connectés</div>
      <div id="account-list"></div>
      <div class="account-menu-divider"></div>
      <button class="account-menu-item add-account" onclick="App.openAddAccount()">
        <div style="width:26px;height:26px;border-radius:8px;background:rgba(3,92,128,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#035c80" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </div>
        Ajouter un compte
      </button>
    </div>
  </div>

  <div style="margin-left:auto;display:flex;align-items:center;gap:8px;">
    <!-- Notification -->
    <div style="position:relative;">
      <button class="icon-btn" id="notif-btn" title="Notifications" onclick="App.clearNotif()">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
      </button>
      <span id="notif-dot" style="display:none;position:absolute;top:-2px;right:-2px;width:8px;height:8px;background:#ef4444;border-radius:50%;animation:pulse 1.8s infinite;"></span>
    </div>

    <!-- Theme -->
    <button class="icon-btn" onclick="App.toggleTheme()" title="Thème">
      <svg id="ico-moon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      <svg id="ico-sun"  width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none;"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/></svg>
    </button>

    <!-- Settings -->
    <button class="icon-btn" onclick="App.openSettings()" title="Paramètres">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
    </button>

    <!-- Logout -->
    <button class="icon-btn" title="Déconnexion" onclick="App.confirmLogout()">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
    </button>

    <!-- Modale confirmation déconnexion -->
    <div id="logout-modal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.6);align-items:center;justify-content:center;">
      <div id="logout-card" style="background:var(--bg-panel);border:1px solid var(--border);border-radius:18px;width:340px;padding:28px 28px 24px;box-shadow:0 24px 64px rgba(0,0,0,0.55);animation:logoutSlideUp .2s ease;">
        <!-- Icône -->
        <div style="width:52px;height:52px;border-radius:14px;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.2);display:flex;align-items:center;justify-content:center;margin:0 auto 18px;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#f87171" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </div>
        <!-- Texte -->
        <div style="text-align:center;margin-bottom:22px;">
          <div style="font-size:17px;font-weight:800;color:var(--text-1);margin-bottom:8px;">Se déconnecter ?</div>
          <div style="font-size:13px;color:var(--text-muted);line-height:1.6;">Vous serez redirigé vers la page de connexion. Vos brouillons non sauvegardés seront perdus.</div>
        </div>
        <!-- Boutons -->
        <div style="display:flex;gap:10px;">
          <button onclick="App.cancelLogout()" style="flex:1;padding:11px;border-radius:10px;border:1px solid var(--border);background:transparent;color:var(--text-2);font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;transition:all .15s;" onmouseover="this.style.background='var(--bg-hover)'" onmouseout="this.style.background='transparent'">
            Annuler
          </button>
          <button onclick="App.doLogout()" id="logout-confirm-btn" style="flex:1;padding:11px;border-radius:10px;border:none;background:linear-gradient(135deg,#dc2626,#b91c1c);color:white;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit;box-shadow:0 4px 16px rgba(220,38,38,0.3);transition:all .15s;" onmouseover="this.style.transform='translateY(-1px)'" onmouseout="this.style.transform='translateY(0)'">
            Déconnecter
          </button>
        </div>
      </div>
    </div>

    <!-- Form logout caché (soumis par JS) -->
    <form method="POST" action="/logout" id="logout-form" style="display:none;">
      <input type="hidden" name="_csrf" id="logout-csrf" value="">
    </form>
  </div>
</div>

<style>
  @keyframes logoutSlideUp {
    from { opacity:0; transform:translateY(14px) scale(.96); }
    to   { opacity:1; transform:translateY(0)    scale(1);   }
  }
</style>
<style>
  /* ── Topbar responsive mobile ─────────────────────── */
  @media (max-width: 600px) {
    /* Cacher le nom de la marque, garder juste l'icône logo */
    .topbar-brand-hide-mobile { display: none !important; }

    /* Pill account : juste l'avatar, sans email ni chevron */
    #pill-email { display: none !important; }
    .account-pill { padding: 4px 6px !important; gap: 0 !important; }

    /* Topbar : espacements réduits */
    .topbar { gap: 5px !important; padding: 0 8px !important; }

    /* Boutons icônes légèrement plus petits */
    .topbar .icon-btn { width: 28px !important; height: 28px !important; }

    /* Groupe droite (notif, thème, settings, logout) : gap réduit, flex-shrink:0 pour ne jamais déborder */
    .topbar > div[style*="margin-left"] {
      gap: 4px !important;
      flex-shrink: 0 !important;
    }
  }
</style>
