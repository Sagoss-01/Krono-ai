<!-- views/components/compose.ejs v2 -->
<div class="compose-overlay" id="compose-overlay">
  <div class="compose-header">
    <span class="compose-title" id="compose-title">Nouveau message</span>
    <div style="display:flex;gap:6px;">
      <button class="icon-btn-sm" onclick="Compose.saveDraftNow()" title="Sauvegarder brouillon">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
      </button>
      <button class="icon-btn-sm" onclick="Compose.minimize()" title="Réduire">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/></svg>
      </button>
      <button class="icon-btn-sm danger" onclick="Compose.close()" title="Fermer">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>

  <div class="compose-fields">
    <div class="compose-field-row">
      <label class="compose-field-label">À</label>
      <input id="c-to" type="email" class="compose-inp" placeholder="destinataire@example.com" multiple autocomplete="off"/>
    </div>
    <div class="compose-field-row">
      <label class="compose-field-label">Cc</label>
      <input id="c-cc" type="email" class="compose-inp" placeholder="copie@example.com" multiple autocomplete="off"/>
      <button id="bcc-toggle" onclick="Compose.toggleBcc()" title="Ajouter Cci"
        style="background:none;border:none;cursor:pointer;color:var(--text-muted);font-size:11px;font-weight:600;white-space:nowrap;padding:0 6px;transition:color .15s;">+ Cci</button>
    </div>
    <div class="compose-field-row" id="c-bcc-row" style="display:none;">
      <label class="compose-field-label">Cci</label>
      <input id="c-bcc" type="email" class="compose-inp" placeholder="copie cachée@example.com" multiple autocomplete="off"/>
    </div>
    <div class="compose-field-row border-bottom-0">
      <label class="compose-field-label">Objet</label>
      <input id="c-subject" type="text" class="compose-inp" placeholder="Objet du message" autocomplete="off"/>
    </div>
  </div>

  <textarea id="c-body" class="compose-body" placeholder="Rédigez votre message…"></textarea>

  <!-- Pièces jointes -->
  <div id="c-att-area" style="display:none;flex-direction:column;gap:6px;padding:8px 14px;border-top:1px solid var(--border);">
    <div style="display:flex;align-items:center;justify-content:space-between;">
      <span style="font-size:11px;font-weight:700;color:var(--text-muted);letter-spacing:.05em;text-transform:uppercase;">Pièces jointes</span>
      <span id="c-att-count" style="font-size:11px;color:var(--text-muted);"></span>
    </div>
    <div id="c-att-list" style="display:flex;flex-wrap:wrap;gap:6px;"></div>
  </div>

  <div class="compose-footer">
    <!-- Envoyer -->
    <button class="btn-send" onclick="Compose.send()">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
      Envoyer
    </button>

    <!-- Programmer -->
    <button class="btn-tool" id="btn-schedule" onclick="Compose.toggleSchedule()" title="Programmer l'envoi">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
    </button>

    <!-- Templates -->
    <button class="btn-tool" id="btn-templates" onclick="Compose.toggleTemplates()" title="Réponses rapides">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    </button>

    <!-- Joindre -->
    <button class="btn-attach" onclick="Compose.triggerFileInput()" title="Joindre un fichier">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
      Joindre
    </button>

    <!-- Accusé de réception -->
    <label class="dsr-label" title="Demander un accusé de réception">
      <input type="checkbox" id="c-dsr" style="display:none;"/>
      <span id="dsr-icon" class="dsr-icon" onclick="document.getElementById('c-dsr').click();this.classList.toggle('active')">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      </span>
    </label>

    <input type="file" id="c-file-input" multiple style="display:none;" onchange="Compose.onFilesSelected(this)"/>
    <button class="btn-cancel" onclick="Compose.close()">Annuler</button>
    <span class="compose-status" id="compose-status"></span>
  </div>
</div>
