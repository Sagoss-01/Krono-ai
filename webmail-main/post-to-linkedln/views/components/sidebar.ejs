<!-- sidebar.ejs -->
<div class="sidebar" id="sidebar">

  <!-- ══ BOUTON COMPOSER ══════════════════════════════ -->
  <div class="sidebar-top">
    <button class="compose-btn" onclick="Compose.open()">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      <span class="sb-label">Nouveau message</span>
    </button>
  </div>

  <!-- ══ MESSAGERIE ════════════════════════════════════ -->
  <div class="sb-section sb-mail-section" id="sb-mail-section">
    <div class="sb-section-label sb-label">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
      Messagerie
    </div>
    <div class="folder-list" id="folder-list">
      <div class="folder-item active" data-folder="INBOX" onclick="Mail.selectFolder('INBOX',this)" id="folder-inbox">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg>
        <span class="sb-label folder-name">Boîte de réception</span>
        <span class="unread-badge sb-label" id="inbox-badge" style="display:none;"></span>
        <button class="folder-expand-btn sb-label" id="inbox-expand-btn" onclick="event.stopPropagation();Mail.toggleInboxExpand()" title="Sous-dossiers">
          <svg id="inbox-expand-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
      </div>
      <!-- Sous-sections Boîte de réception (même style que les autres dossiers) -->
      <div id="inbox-subsections" style="display:none;">
        <div class="folder-item sub-folder-item" onclick="Mail.activateFilter('unread')" id="sub-unread">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4" fill="currentColor"/></svg>
          <span class="sb-label folder-name">Non lus</span>
          <span class="unread-badge sb-label" id="unread-sub-badge" style="display:none;"></span>
        </div>
        <div class="folder-item sub-folder-item" onclick="Mail.activateFilter('starred')" id="sub-starred">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="#f59e0b" stroke="#f59e0b" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <span class="sb-label folder-name">Étoilés</span>
        </div>
        <div class="folder-item sub-folder-item" onclick="Mail.activateFilter('attachments')" id="sub-attachments">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
          <span class="sb-label folder-name">Pièces jointes</span>
        </div>
      </div>
      <div class="folder-item" data-folder="Sent" onclick="Mail.selectFolder('Sent',this)">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        <span class="sb-label folder-name">Envoyés</span>
      </div>
      <div class="folder-item" data-folder="Drafts" onclick="Mail.selectFolder('Drafts',this)">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        <span class="sb-label folder-name">Brouillons</span>
      </div>
      <div class="folder-item" data-folder="Junk" onclick="Mail.selectFolder('Junk',this)">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span class="sb-label folder-name">Spam</span>
      </div>
      <div class="folder-item" data-folder="Trash" onclick="Mail.selectFolder('Trash',this)">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
        <span class="sb-label folder-name">Corbeille</span>
      </div>
      <!-- Aide raccourcis — au dessus de la corbeille, ouvre dans le panneau détail -->
      <div class="folder-item help-folder-item" onclick="Mail.showHelp()" id="folder-help">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        <span class="sb-label folder-name">Aide &amp; raccourcis</span>
      </div>

      <!-- ══ SÉPARATEUR + REUNION WEB (dans la liste dossiers) ══ -->
      <hr style="border:none;border-top:1px solid var(--border);margin:6px 4px;">
      <div id="sb-meet-section">
        <div class="sb-section-label" onclick="MeetSidebar.toggle()" style="cursor:pointer;justify-content:space-between;display:flex;align-items:center;">
          <span style="display:flex;align-items:center;gap:6px;">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>
            <span class="sb-label">Réunion Web</span>
          </span>
          <svg id="meet-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="transition:transform .2s;flex-shrink:0;margin-right:4px;"><polyline points="6 9 12 15 18 9"/></svg>
        </div>
        <div id="sb-meet-body" style="display:none;">
          <!-- Nouvelle réunion instantanée -->
          <div class="folder-item meet-instant-item" onclick="MeetSidebar.instant()">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            <span class="folder-name sb-label">Démarrer maintenant</span>
          </div>
          <!-- Programmer une réunion -->
          <div class="folder-item" onclick="MeetSidebar.openSchedule()">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <span class="folder-name sb-label">Programmer</span>
          </div>
          <!-- Rejoindre -->
          <div class="folder-item" onclick="MeetSidebar.openJoin()">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
            <span class="folder-name sb-label">Rejoindre</span>
          </div>
          <!-- Historique -->
          <div class="folder-item" onclick="MeetSidebar.openHistory()">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span class="folder-name sb-label">Historique</span>
          </div>
          <!-- Mes réunions programmées -->
           <!-- Maître Mémoire 
<div class="folder-item" onclick="location.href='/master-memory'">
  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M12 3l7 4v10l-7 4-7-4V7l7-4z"></path>
    <path d="M9 11h6"></path>
    <path d="M9 15h4"></path>
  </svg>
  <span class="folder-name sb-label">Maître Mémoire</span>
</div>-->
          <div id="sb-my-meetings"></div>
        </div>
      </div>

      <div id="extra-folders"></div>
    </div>
  </div>

  <!-- ══ SÉPARATEUR ═══════════════════════════════════ -->
  <div class="sb-divider"></div>

  <!-- ══ DISCUSSIONS — bouton mode plein écran ════════ -->
  <div class="sb-section sb-chat-section" id="sb-chat-section">
    <div class="sb-section-label sb-label">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      Discussions
      <span class="unread-badge sb-label" id="chat-unread-badge" style="display:none;margin-left:auto;"></span>
    </div>

    <!-- Liste compacte des conversations dans la sidebar -->
    <div id="chat-conv-list" class="chat-conv-list">
      <div class="chat-conv-empty" id="chat-conv-empty">
        <span>Aucune conversation</span>
      </div>
    </div>

    <!-- Bouton ouvrir le mode chat complet -->
    <div class="chat-new-btn-wrap sb-label">
      <button class="chat-new-btn chat-open-btn" onclick="ChatUI.showChatMode()">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        <span class="sb-label">Ouvrir discussions</span>
      </button>
    </div>
  </div>

  <!-- ══ FOOTER ════════════════════════════════════════ -->
  <div class="sidebar-footer">

    <!-- Quota stockage — entre Discussions et statut connexion -->
    <div id="quota-block" class="quota-card sb-label" style="display:none;">
      <div class="quota-card-header">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <ellipse cx="12" cy="5" rx="9" ry="3"/>
          <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/>
          <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>
        </svg>
        <span class="quota-card-label">Espace utilisé</span>
        <span id="quota-pct" class="quota-card-pct">—</span>
      </div>
      <div class="quota-bar-track">
        <div class="quota-bar-fill" id="quota-bar"></div>
      </div>
      <div class="quota-card-detail">
        <span id="quota-used">—</span>
        <span id="quota-total">—</span>
      </div>
    </div>

    <div class="conn-status">
      <span class="conn-dot"></span>
      <span class="sb-label" style="font-size:11px;color:var(--text-muted);">Connecté — netiify.cloud</span>
    </div>
  </div>
</div>
