<style>
/* ── Actions boutons mobile ─────────────────────────── */
@media (max-width: 768px) {
  /* Cacher les boutons secondaires sur mobile */
  .desktop-action { display: none !important; }

  /* Afficher les éléments mobile-only */
  .mobile-only { display: flex !important; }
}
@media (min-width: 769px) {
  /* Cacher les éléments mobile-only sur desktop */
  .mobile-only { display: none !important; }
}

/* Menu "Plus" — wrapper positionné */
.more-actions-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

/* Dropdown "Plus" */
.more-actions-menu {
  position: absolute;
  top: calc(100% + 6px);
  right: 0;
  z-index: 500;
  background: var(--bg-panel);
  border: 1px solid var(--border);
  border-radius: 12px;
  box-shadow: 0 12px 32px rgba(0,0,0,0.35);
  min-width: 190px;
  overflow: hidden;
  animation: fadeUp .15s ease;
}

.more-action-item {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  padding: 10px 14px;
  background: none;
  border: none;
  color: var(--text-2);
  font-size: 13px;
  font-family: 'Sora', sans-serif;
  cursor: pointer;
  text-align: left;
  transition: background .1s;
}
.more-action-item:hover {
  background: var(--bg-hover);
  color: var(--accent);
}
.more-action-item svg {
  flex-shrink: 0;
  color: var(--text-3);
}
</style>

<script>
/* ──────────────────────────────────────────────────────────
   MailUI — toggle menu "Plus" sur mobile + patch des liens
   ────────────────────────────────────────────────────────── */

/* Évite d'écraser un MailUI déjà défini par mail.js */
window.MailUI = window.MailUI || {};

/* Toggle du menu "Plus d'actions" (mobile) */
MailUI.toggleMoreMenu = function() {
  var menu = document.getElementById('more-actions-menu');
  if (!menu) return;
  var isOpen = menu.style.display !== 'none';
  menu.style.display = isOpen ? 'none' : 'block';
  if (!isOpen) {
    setTimeout(function() {
      document.addEventListener('click', function handler(e) {
        var wrap = document.getElementById('more-actions-wrap');
        if (wrap && !wrap.contains(e.target)) {
          menu.style.display = 'none';
          document.removeEventListener('click', handler);
        }
      });
    }, 0);
  }
};

/**
 * patchMailLinks()
 * Appelé après injection du HTML dans #v-body.
 * - Force tous les liens à s'ouvrir dans un nouvel onglet
 * - Ajoute rel="noopener noreferrer" pour la sécurité
 * - Affiche une brève notification du domaine ciblé
 */
MailUI.patchMailLinks = function() {
  var body = document.getElementById('v-body');
  if (!body) return;

  var links = body.querySelectorAll('a[href]');
  links.forEach(function(link) {
    var href = link.getAttribute('href') || '';

    /* Ignorer les ancres internes et les protocoles non-http */
    if (!href || href.startsWith('#') || href.startsWith('javascript:')) {
      /* Bloquer javascript: pour la sécurité */
      if (href.startsWith('javascript:')) {
        link.removeAttribute('href');
        link.style.cursor = 'default';
      }
      return;
    }

    link.setAttribute('target', '_blank');
    link.setAttribute('rel', 'noopener noreferrer');

    /* Notification visuelle discrète au survol */
    link.addEventListener('mouseenter', function() {
      try {
        var url = new URL(href.startsWith('//') ? 'https:' + href : href);
        var warn = document.getElementById('v-external-link-warn');
        var urlSpan = document.getElementById('v-external-link-url');
        if (warn && urlSpan) {
          urlSpan.textContent = url.hostname;
          warn.style.display = 'block';
        }
      } catch(e) { /* URL invalide, on ignore */ }
    });
    link.addEventListener('mouseleave', function() {
      var warn = document.getElementById('v-external-link-warn');
      if (warn) warn.style.display = 'none';
    });
  });
};
</script>

</body>
</html>