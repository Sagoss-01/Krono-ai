<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>

  <!-- ── SEO ─────────────────────────────────────── -->
  <title><%= title %></title>
  <meta name="description" content="TechSphere Webmail — Messagerie professionnelle sécurisée propulsée par netiify.cloud"/>
  <meta name="keywords"    content="webmail, messagerie, email, TechSphere, netiify"/>
  <meta name="author"      content="TechSphere / netiify.cloud"/>
  <meta name="robots"      content="noindex, nofollow"/>
  <meta name="theme-color" content="#035c80"/>

  <!-- ── Open Graph (Facebook, LinkedIn…) ─────────── -->
  <meta property="og:type"        content="website"/>
  <meta property="og:url"         content="https://mail.netiify.cloud/"/>
  <meta property="og:title"       content="TechSphere Webmail"/>
  <meta property="og:description" content="Messagerie professionnelle sécurisée — netiify.cloud"/>
  <meta property="og:image"       content="/logo.png"/>
  <meta property="og:image:width"  content="1200"/>
  <meta property="og:image:height" content="630"/>
  <meta property="og:site_name"   content="TechSphere Webmail"/>
  <meta property="og:locale"      content="fr_FR"/>

  <!-- ── Twitter Card ─────────────────────────────── -->
  <meta name="twitter:card"        content="summary_large_image"/>
  <meta name="twitter:title"       content="TechSphere Webmail"/>
  <meta name="twitter:description" content="Messagerie professionnelle sécurisée — netiify.cloud"/>
  <meta name="twitter:image"       content="/logo.png"/>

  <!-- ── Favicon ──────────────────────────────────── -->
  <link rel="icon"             href="/favicon.ico" type="image/x-icon"/>
  <link rel="shortcut icon"    href="/favicon.ico"/>
  <link rel="apple-touch-icon" href="/logo.png"/>
  <link rel="manifest"         href="/manifest.json"/>

  <!-- ── CSRF ─────────────────────────────────────── -->
  <meta name="csrf-token" content="<%= locals.csrfToken || '' %>">

  <!-- ── Styles ───────────────────────────────────── -->
  <link rel="stylesheet" href="/css/style.css"/>
  <link rel="stylesheet" href="/css/mail.css"/>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet"/>
  <script src="/socket.io/socket.io.js"></script>
</head>
<body>
  <%- include('../components/topbar') %>

  <div class="app-body">
    <%- include('../components/sidebar') %>

    <!-- ══ MODE MAIL ══════════════════════════════════════ -->
    <div id="mode-mail" class="mode-container">
      <!-- Liste emails -->
      <div class="list-panel" id="list-panel">
        <div class="list-header">
          <div class="list-header-top">
            <span class="folder-title" id="folder-title">Boîte de réception</span>
            <div style="display:flex;align-items:center;gap:6px;">
              <span class="cache-badge" id="cache-badge" style="display:none;">
                <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>Cache
              </span>
              <button class="icon-btn" id="thread-btn" onclick="Mail.toggleThread()" title="Vue conversation">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
              </button>
              <button class="icon-btn" id="compact-btn" onclick="Mail.toggleCompact()" title="Mode compact">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/></svg>
              </button>
              <button class="icon-btn" onclick="Mail.markAllReadInFolder()" title="Tout marquer comme lu">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              </button>
              <button class="icon-btn" id="refresh-btn" onclick="Mail.refresh()">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
              </button>
            </div>
          </div>
          <div style="display:flex;gap:5px;align-items:center;">
          <input type="text" class="search-inp" id="search-inp" placeholder="Rechercher…" oninput="Mail.filter()" autocomplete="off" name="mail-search" style="flex:1;"/>
          <button class="icon-btn" onclick="Mail.toggleAdvancedSearch()" title="Recherche avancée" style="flex-shrink:0;"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg></button>
        </div>
        </div>
        <!-- Barre de sélection multiple -->
        <div id="selection-bar" style="display:none;align-items:center;gap:8px;padding:6px 12px;background:var(--accent-lo);border-bottom:1px solid var(--accent);font-size:12px;flex-shrink:0;">
          <span id="sel-count" style="font-weight:700;color:var(--accent);flex:1;"></span>
          <button onclick="Mail.selectAll()" style="background:none;border:none;cursor:pointer;font-size:11px;color:var(--accent);font-weight:600;padding:2px 6px;border-radius:5px;" title="Tout sélectionner">Tout</button>
          <button onclick="Mail.deleteSelected()" style="background:#ef4444;border:none;cursor:pointer;color:white;font-size:11px;font-weight:700;padding:3px 8px;border-radius:5px;">Supprimer</button>
          <button onclick="Mail.clearSelection()" style="background:none;border:none;cursor:pointer;font-size:11px;color:var(--text-muted);padding:2px 6px;border-radius:5px;">✕</button>
        </div>

        <div class="list-state" id="list-loading">
          <svg class="spin" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
          <span>Chargement…</span>
        </div>
        <div class="list-state" id="list-empty" style="display:none;">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg>
          <span>Aucun email</span>
        </div>
        <div id="list-items" style="display:none;overflow-y:auto;flex:1;"></div>
      </div>

      <!-- Handle resize -->
      <div class="resize-handle" id="resize-handle" title="Glisser pour redimensionner"></div>

      <!-- Détail email -->
      <div class="view-panel" id="view-panel">
        <div class="view-state" id="view-empty">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
          <span>Sélectionnez un email</span>
        </div>
        <div class="view-state" id="view-loading" style="display:none;">
          <svg class="spin" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
        </div>
        <div id="view-content" style="display:none;flex-direction:column;height:100%;">
          <div class="view-header">
            <div class="view-header-top">
              <h2 class="view-subject" id="v-subject"></h2>
              <div class="view-actions">
                <!-- Retour mobile -->
                <button class="icon-btn mobile-only" onclick="Mail.closeMobile()" title="Retour"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg></button>
                <!-- Boutons principaux toujours visibles -->
                <button class="icon-btn" onclick="Mail.reply()" title="Répondre (R)" aria-label="Répondre"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 17 4 12 9 7"/><path d="M20 18v-2a4 4 0 0 0-4-4H4"/></svg></button>
                <button class="icon-btn" onclick="Mail.replyAll()" title="Répondre à tous" aria-label="Répondre à tous"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="7 17 2 12 7 7"/><polyline points="12 17 7 12 12 7"/><path d="M22 18v-2a4 4 0 0 0-4-4H7"/></svg></button>
                <button class="icon-btn" onclick="Mail.forward()" title="Transférer (F)" aria-label="Transférer"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 17 20 12 15 7"/><path d="M4 18v-2a4 4 0 0 1 4-4h12"/></svg></button>
                <button class="icon-btn danger" onclick="Mail.deleteEmail()" title="Supprimer (D)" aria-label="Supprimer"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg></button>
                <!-- Boutons secondaires : visibles desktop, cachés mobile -->
                <button class="icon-btn desktop-action" id="v-star-btn" onclick="Mail.toggleStar()" title="Étoiler (S)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></button>
                <button class="icon-btn desktop-action" onclick="Mail.toggleRead()" title="Marquer lu/non-lu (U)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg></button>
                <button class="icon-btn desktop-action" id="v-move-btn" onclick="Mail.showMoveDropdown()" title="Déplacer vers…"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg></button>
                <button class="icon-btn desktop-action" onclick="Mail.markSpam()" title="Marquer comme spam"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg></button>
                <button class="icon-btn desktop-action" onclick="Mail.printEmail()" title="Imprimer"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg></button>
                <button class="icon-btn desktop-action" onclick="Mail.exportEml()" title="Exporter .eml"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></button>
                <!-- Bouton "Plus" mobile uniquement -->
                <div class="more-actions-wrap mobile-only" id="more-actions-wrap">
                  <button class="icon-btn" id="more-actions-btn" onclick="MailUI.toggleMoreMenu()" title="Plus d'actions">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="5" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/></svg>
                  </button>
                  <div class="more-actions-menu" id="more-actions-menu" style="display:none;">
                    <button class="more-action-item" onclick="Mail.toggleStar();MailUI.toggleMoreMenu()"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg> Étoiler</button>
                    <button class="more-action-item" onclick="Mail.toggleRead();MailUI.toggleMoreMenu()"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg> Marquer lu/non-lu</button>
                    <button class="more-action-item" onclick="Mail.showMoveDropdown();MailUI.toggleMoreMenu()"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg> Déplacer</button>
                    <button class="more-action-item" onclick="Mail.markSpam();MailUI.toggleMoreMenu()"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg> Spam</button>
                    <button class="more-action-item" onclick="Mail.printEmail();MailUI.toggleMoreMenu()"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg> Imprimer</button>
                    <button class="more-action-item" onclick="Mail.exportEml();MailUI.toggleMoreMenu()"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg> Exporter .eml</button>
                  </div>
                </div>
              </div>
            </div>
            <div class="view-meta">
              <div class="view-avatar" id="v-avatar">?</div>
              <div class="view-meta-text">
                <div class="view-from" id="v-from"></div>
                <div class="view-to"   id="v-to"></div>
                <div class="view-cc"   id="v-cc" style="display:none;"></div>
              </div>
              <div style="display:flex;flex-direction:column;align-items:flex-end;gap:3px;flex-shrink:0;">
                <div class="view-date" id="v-date"></div>
                <span id="v-size" style="display:none;font-size:10px;color:var(--text-muted);font-family:'JetBrains Mono',monospace;"></span>
              </div>
            </div>
            <div class="view-attachments" id="v-attachments" style="display:none;"></div>
          </div>
          <div class="view-body"><div id="v-body" class="mail-html"></div></div>
          <!-- Avertissement liens externes -->
          <div id="v-external-link-warn" style="display:none;position:fixed;bottom:18px;left:50%;transform:translateX(-50%);background:var(--bg-panel);border:1px solid var(--border);border-radius:10px;padding:10px 16px;font-size:12px;color:var(--text-2);box-shadow:0 8px 24px rgba(0,0,0,0.3);z-index:9999;max-width:340px;text-align:center;animation:fadeUp .2s ease;\">
            🔗 <span id=\"v-external-link-url\" style=\"color:var(--accent);word-break:break-all;\"></span><br>
            <small style=\"color:var(--text-muted);\">Ce lien va s'ouvrir dans un nouvel onglet.</small>
          </div>
        </div>
      </div>
    </div>

    <!-- ══ MODE CHAT ══════════════════════════════════════ -->
    <div id="mode-chat" class="mode-container" style="display:none;">

      <!-- Liste conversations (même style que liste emails) -->
      <div class="list-panel" id="chat-list-panel">
        <div class="list-header">
          <div class="list-header-top">
            <span class="folder-title">
              <button class="icon-btn" onclick="ChatUI.showMailMode()" title="Retour messagerie" style="margin-right:6px;">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
              </button>
              Discussions
            </span>
            <button class="icon-btn" onclick="ChatUI.promptNew()" title="Nouvelle conversation">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </button>
          </div>
          <input type="text" class="search-inp" id="chat-search" placeholder="Rechercher une conversation…" oninput="ChatUI.filterConvs(this.value)" autocomplete="off"/>
          <input type="text" class="search-inp" id="chat-msg-search" placeholder="Rechercher dans les messages…" oninput="ChatUI.searchMessages(this.value)" autocomplete="off" style="display:none;margin-top:4px;"/>
        </div>

        <!-- État chargement -->
        <div class="list-state" id="chat-conv-loading">
          <svg class="spin" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
          <span>Chargement…</span>
        </div>
        <!-- État vide -->
        <div class="list-state" id="chat-conv-empty" style="display:none;">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          <span>Aucune conversation.<br>Cliquez + pour en démarrer une.</span>
        </div>
        <!-- Liste -->
        <div id="chat-conv-items" style="overflow-y:auto;flex:1;"></div>
      </div>

      <!-- Zone de messages (même style que vue email) -->
      <div class="view-panel" id="chat-view-panel">
        <div class="view-state" id="chat-view-empty">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          <span>Sélectionnez une conversation</span>
        </div>
        <div id="chat-active" style="display:none;flex-direction:column;height:100%;">
          <!-- Header conversation -->
          <div class="chat-view-header">
            <button class="chat-back-btn" id="chat-back-btn" onclick="ChatUI.goBackToList()" title="Retour">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            </button>
            <div id="chat-peer-avatar" style="flex-shrink:0;"></div>
            <div style="flex:1;">
              <div class="chat-view-peer-name" id="chat-peer-name">—</div>
              <div class="chat-view-peer-sub"  id="chat-peer-sub">Discussion privée</div>
            </div>
          </div>
          <!-- Messages -->
          <div class="chat-view-messages" id="chat-view-messages"></div>
          <!-- Saisie -->
          <div class="chat-view-input-area">
            <button class="chat-attach-btn" onclick="ChatUI.triggerFile()" title="Joindre fichier ou photo">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
            </button>
            <input type="file" id="chat-file-input" style="display:none;" multiple accept="image/*,application/pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.zip,.rar,.7z,.txt,.csv,.json,.mp3,.mp4,.mov" onchange="ChatUI.onFileSelected(this)"/>
            <textarea id="chat-input" class="chat-view-input" placeholder="Message…" rows="1"
              onkeydown="ChatUI.onKeyDown(event)"
              oninput="this.style.height='auto';this.style.height=Math.min(this.scrollHeight,100)+'px'"></textarea>
            <button class="chat-send-btn" onclick="ChatUI.send()">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('../components/compose') %>
  <%- include('../components/modals') %>

  <!-- ══ MODAL CONFIRMATION (HTML avant les scripts) ══ -->
  <div id="confirm-modal" style="display:none;" onclick="if(event.target===this)ConfirmModal.cancel()">
    <div onclick="event.stopPropagation()" style="background:var(--bg-panel);border:1px solid var(--border);border-radius:18px;box-shadow:0 32px 80px rgba(0,0,0,0.55);max-width:400px;width:92%;padding:32px 28px 24px;text-align:center;display:flex;flex-direction:column;align-items:center;animation:fadeUp .2s ease;">
      <div id="confirm-icon"  style="margin-bottom:14px;"></div>
      <div id="confirm-title" style="font-size:17px;font-weight:800;color:var(--text-1);margin-bottom:8px;font-family:Sora,sans-serif;"></div>
      <div id="confirm-body"  style="font-size:13px;color:var(--text-muted);margin-bottom:22px;line-height:1.6;font-family:Sora,sans-serif;"></div>
      <div style="display:flex;gap:10px;justify-content:center;width:100%;">
