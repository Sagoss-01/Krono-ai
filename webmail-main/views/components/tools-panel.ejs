<!-- views/components/tools-panel.ejs -->
<!-- ══ MODE OUTILS (Calendrier + Contacts) ═══════════════════════════════ -->
<div id="mode-tools" class="mode-container" style="display:none;">

  <!-- Sous-vue Calendrier -->
  <div id="tools-view-calendar" class="tools-view">
    <div class="list-header">
      <div class="list-header-top">
        <span class="folder-title" id="cal-month-label">Calendrier</span>
        <div style="display:flex;align-items:center;gap:6px;">
          <button class="icon-btn" onclick="ToolsUI.calPrevMonth()" title="Mois précédent">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <button class="icon-btn" onclick="ToolsUI.calNextMonth()" title="Mois suivant">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
          <button class="icon-btn" onclick="ToolsUI.calOpenNew()" title="Nouvel événement">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </button>
        </div>
      </div>
    </div>
    <div class="tools-scroll">
      <div class="tools-cal-grid" id="tools-cal-dow"></div>
      <div class="tools-cal-grid" id="tools-cal-grid" style="margin-top:6px;"></div>

      <div id="tools-cal-day-list" style="display:none;margin-top:20px;">
        <div id="tools-cal-day-title" style="font-size:13px;font-weight:700;margin-bottom:10px;color:var(--text-1);"></div>
        <div id="tools-cal-day-items"></div>
      </div>
    </div>
  </div>

  <!-- Sous-vue Contacts -->
  <div id="tools-view-contacts" class="tools-view" style="display:none;">
    <div class="list-header">
      <div class="list-header-top">
        <span class="folder-title">Contacts</span>
        <button class="icon-btn" onclick="ToolsUI.cxOpenNew()" title="Nouveau contact">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </button>
      </div>
      <div style="padding:10px 16px 0;">
        <input type="text" id="tools-cx-search" class="tools-search-inp" placeholder="Rechercher un contact…" oninput="ToolsUI.cxSearch(this.value)" />
      </div>
    </div>
    <div class="tools-scroll" id="tools-cx-list"></div>
  </div>

  <!-- Sous-vue Administration -->
  <div id="tools-view-admin" class="tools-view" style="display:none;">
    <div class="list-header">
      <div class="list-header-top">
        <span class="folder-title">Administration</span>
      </div>
    </div>
    <div class="tools-scroll">
      <div class="tools-adm-stats" id="tools-adm-stats"></div>

      <div class="tools-adm-tabs">
        <button class="tools-adm-tab active" id="adm-tab-activity"  onclick="ToolsUI.admShowTab('activity')">Activité</button>
        <button class="tools-adm-tab"        id="adm-tab-accounts"  onclick="ToolsUI.admShowTab('accounts')">Comptes</button>
        <button class="tools-adm-tab"        id="adm-tab-meetings"  onclick="ToolsUI.admShowTab('meetings')">Réunions</button>
        <button class="tools-adm-tab"        id="adm-tab-admins"    onclick="ToolsUI.admShowTab('admins')">Administrateurs</button>
        <button class="tools-adm-tab"        id="adm-tab-ai"        onclick="ToolsUI.admShowTab('ai')">IA</button>
      </div>

      <div id="adm-panel-activity" class="tools-adm-panel"></div>
      <div id="adm-panel-accounts" class="tools-adm-panel" style="display:none;"></div>
      <div id="adm-panel-meetings" class="tools-adm-panel" style="display:none;"></div>
      <div id="adm-panel-admins"   class="tools-adm-panel" style="display:none;"></div>
      <div id="adm-panel-ai"       class="tools-adm-panel" style="display:none;"></div>
    </div>
  </div>

</div>

<!-- Modal confirmation admin (suspendre / supprimer un compte) -->
<div class="tools-modal" id="tools-adm-modal">
  <div class="tools-modal-card">
    <h3 id="tools-adm-modal-title">Action</h3>
    <div id="tools-adm-modal-body" style="font-size:13px;color:var(--text-1);margin-bottom:14px;line-height:1.6;"></div>
    <div class="tools-field" id="tools-adm-reason-field" style="display:none;">
      <label>Motif (optionnel, envoyé à l'utilisateur)</label>
      <input type="text" id="tools-adm-reason-inp" placeholder="Ex : usage abusif signalé" />
    </div>
    <div id="tools-adm-modal-err" class="tools-modal-err"></div>
    <div class="tools-modal-actions">
      <button class="tools-cancel" onclick="ToolsUI.admCloseModal()">Annuler</button>
      <button class="tools-save" id="tools-adm-modal-confirm" style="background:#dc2626;">Confirmer</button>
    </div>
  </div>
</div>

<!-- Modal ajout d'administrateur -->
<div class="tools-modal" id="tools-adm-add-modal">
  <div class="tools-modal-card">
    <h3>Ajouter un administrateur</h3>
    <div class="tools-field">
      <label>Email</label>
      <input type="email" id="tools-adm-add-email" placeholder="nouvel.admin@netiify.cloud" />
    </div>
    <div id="tools-adm-add-err" class="tools-modal-err"></div>
    <div class="tools-modal-actions">
      <button class="tools-cancel" onclick="ToolsUI.admCloseAddModal()">Annuler</button>
      <button class="tools-save" onclick="ToolsUI.admConfirmAddAdmin()">Ajouter</button>
    </div>
  </div>
</div>
<div class="tools-modal" id="tools-cal-modal">
  <div class="tools-modal-card">
    <h3 id="tools-cal-modal-title">Nouvel événement</h3>
    <input type="hidden" id="tools-cal-id" />

    <label class="tools-toggle">
      <input type="checkbox" id="tools-cal-is-meeting" onchange="ToolsUI.calOnMeetingToggle()" />
      <div>
        <div style="font-size:12px;font-weight:700;">C'est une réunion</div>
        <div style="font-size:10px;color:var(--text-muted);">Crée aussi un lien de visioconférence et l'envoie aux invités</div>
      </div>
    </label>

    <div class="tools-field"><label>Titre *</label><input type="text" id="tools-cal-title" placeholder="Ex: Point d'équipe" /></div>
    <div class="tools-row2">
      <div class="tools-field"><label>Début *</label><input type="datetime-local" id="tools-cal-start" /></div>
      <div class="tools-field"><label>Fin *</label><input type="datetime-local" id="tools-cal-end" /></div>
    </div>
    <div class="tools-field" id="tools-cal-location-field"><label>Lieu</label><input type="text" id="tools-cal-location" placeholder="Optionnel" /></div>
    <div class="tools-field"><label>Description</label><textarea id="tools-cal-description" rows="2"></textarea></div>
    <div class="tools-field"><label>Invités (emails séparés par virgule)</label><input type="text" id="tools-cal-attendees" placeholder="alice@ex.com, bob@ex.com" /></div>
    <div class="tools-field"><label>Rappel</label>
      <select id="tools-cal-reminder" class="tools-select">
        <option value="">Aucun</option>
        <option value="10" selected>10 minutes avant</option>
        <option value="30">30 minutes avant</option>
        <option value="60">1 heure avant</option>
        <option value="1440">1 jour avant</option>
      </select>
    </div>

    <div id="tools-cal-modal-err" class="tools-modal-err"></div>
    <div class="tools-modal-actions">
      <button class="tools-cancel" onclick="ToolsUI.calCloseModal()">Annuler</button>
      <button class="tools-save" onclick="ToolsUI.calSave()">Enregistrer</button>
    </div>
    <div class="tools-delete-link" id="tools-cal-delete-link" style="display:none;" onclick="ToolsUI.calRemoveCurrent()">Supprimer cet événement</div>
  </div>
</div>

<!-- Modal contact -->
<div class="tools-modal" id="tools-cx-modal">
  <div class="tools-modal-card">
    <h3 id="tools-cx-modal-title">Nouveau contact</h3>
    <input type="hidden" id="tools-cx-id" />
    <div class="tools-field"><label>Nom *</label><input type="text" id="tools-cx-name" /></div>
    <div class="tools-field"><label>Email *</label><input type="email" id="tools-cx-email" /></div>
    <div class="tools-field"><label>Téléphone</label><input type="text" id="tools-cx-phone" /></div>
    <div class="tools-field"><label>Société</label><input type="text" id="tools-cx-company" /></div>
    <div class="tools-field"><label>Notes</label><textarea id="tools-cx-notes" rows="2"></textarea></div>
    <div id="tools-cx-modal-err" class="tools-modal-err"></div>
    <div class="tools-modal-actions">
      <button class="tools-cancel" onclick="ToolsUI.cxCloseModal()">Annuler</button>
      <button class="tools-save" onclick="ToolsUI.cxSave()">Enregistrer</button>
    </div>
  </div>
</div>

<style>
  .tools-view { display: flex; flex-direction: column; height: 100%; width: 100%; }
  .tools-scroll { flex: 1; overflow-y: auto; padding: 16px; }

  .tools-search-inp { width: 100%; padding: 8px 12px; border-radius: 9px; border: 1px solid var(--border);
    background: var(--bg-card); color: var(--text-1); font-size: 12px; font-family: 'Sora', sans-serif; outline: none; box-sizing: border-box; }

  /* Calendrier */
  .tools-cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 5px; }
  .tools-cal-dow-cell { text-align: center; font-size: 10px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; padding: 4px 0; }
  .tools-cal-cell { min-height: 74px; border-radius: 9px; border: 1px solid var(--border); background: var(--bg-card);
    padding: 5px; cursor: pointer; display: flex; flex-direction: column; gap: 2px; overflow: hidden; }
  .tools-cal-cell.other-month { opacity: .35; }
  .tools-cal-cell.today { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent) inset; }
  .tools-cal-daynum { font-size: 10px; font-weight: 700; color: var(--text-2); }
  .tools-cal-evt { font-size: 9px; padding: 2px 4px; border-radius: 4px; background: var(--accent-lo); color: var(--accent);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tools-cal-evt.meeting { background: rgba(139,92,246,.18); color: #8b5cf6; }
  .tools-cal-evt-more { font-size: 9px; color: var(--text-muted); }
  .tools-cal-day-item { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 9px;
    background: var(--bg-card); border: 1px solid var(--border); margin-bottom: 7px; cursor: pointer; }
  .tools-cal-day-item .time { font-size: 11px; font-weight: 700; color: var(--accent); min-width: 42px; }
  .tools-cal-day-item .title { font-size: 12px; font-weight: 600; flex: 1; color: var(--text-1); }
  .tools-cal-day-item .meta { font-size: 10px; color: var(--text-muted); }

  /* Contacts */
  .tools-cx-card { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: 10px;
    background: var(--bg-card); border: 1px solid var(--border); margin-bottom: 8px; }
  .tools-cx-avatar { width: 36px; height: 36px; border-radius: 50%; background: var(--accent);
    display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 800; font-size: 13px; flex-shrink: 0; }
  .tools-cx-info { flex: 1; min-width: 0; }
  .tools-cx-name { font-size: 13px; font-weight: 700; color: var(--text-1); }
  .tools-cx-sub { font-size: 11px; color: var(--text-muted); margin-top: 2px; }
  .tools-cx-actions { display: flex; gap: 5px; flex-shrink: 0; }
  .tools-cx-icon-btn { width: 28px; height: 28px; border-radius: 7px; border: 1px solid var(--border); background: transparent;
    color: var(--text-2); cursor: pointer; display: flex; align-items: center; justify-content: center; }
  .tools-cx-icon-btn.fav.active { color: var(--accent); border-color: var(--accent); background: var(--accent-lo); }
  .tools-empty { text-align: center; padding: 50px 16px; color: var(--text-muted); font-size: 13px; }

  /* Modals (mêmes conventions que le reste de l'app) */
  .tools-modal { position: fixed; inset: 0; z-index: 9999; background: rgba(0,0,0,.65); display: none; align-items: center; justify-content: center; padding: 16px; }
  .tools-modal.open { display: flex; }
  .tools-modal-card { background: var(--bg-panel); border: 1px solid var(--border); border-radius: 16px; width: 440px; max-width: 100%;
    max-height: 88vh; overflow-y: auto; padding: 22px; }
  .tools-modal-card h3 { margin: 0 0 16px; font-size: 15px; color: var(--text-1); }
  .tools-field { margin-bottom: 12px; }
  .tools-field label { display: block; font-size: 10px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 5px; }
  .tools-field input, .tools-field textarea, .tools-select { width: 100%; padding: 9px 11px; border-radius: 8px; border: 1px solid var(--border);
    background: var(--bg-card); color: var(--text-1); font-size: 13px; font-family: 'Sora', sans-serif; outline: none; box-sizing: border-box; }
  .tools-row2 { display: flex; gap: 10px; }
  .tools-row2 > div { flex: 1; }
  .tools-toggle { display: flex; align-items: center; gap: 8px; padding: 9px 11px; border-radius: 8px; border: 1px solid var(--border);
    background: var(--accent-lo); cursor: pointer; margin-bottom: 12px; }
  .tools-toggle input { accent-color: var(--accent); width: 15px; height: 15px; }
  .tools-modal-actions { display: flex; gap: 10px; margin-top: 16px; }
  .tools-modal-actions button { flex: 1; padding: 10px; border-radius: 9px; font-size: 13px; font-weight: 700; cursor: pointer; font-family: 'Sora', sans-serif; }
  .tools-cancel { background: transparent; border: 1px solid var(--border); color: var(--text-2); }
  .tools-save { background: var(--accent); border: none; color: #fff; }
  .tools-modal-err { font-size: 12px; color: #f87171; min-height: 16px; margin-top: 4px; }
  .tools-delete-link { text-align: center; margin-top: 10px; font-size: 12px; color: #f87171; cursor: pointer; }

  /* ══ Responsive mobile — absent jusqu'ici, ajouté ══════════════════════ */
  @media (max-width: 768px) {
    .tools-scroll { padding: 12px; }
    .tools-cal-grid { gap: 3px; }
    .tools-cal-cell { min-height: 56px; padding: 4px; border-radius: 7px; }
    .tools-cal-daynum { font-size: 9px; }
    .tools-cal-evt { font-size: 8px; padding: 1px 3px; }
    .tools-cal-dow-cell { font-size: 9px; padding: 3px 0; }
    .tools-cal-day-item { padding: 9px 10px; }

    .tools-modal-card { width: 100%; max-width: 94vw; padding: 16px; max-height: 92vh; }
    .tools-row2 { flex-direction: column; gap: 0; }

    .tools-cx-card { flex-wrap: wrap; }
    .tools-cx-actions { margin-left: auto; }

    /* Le header liste (titre + boutons) passe sur 2 lignes proprement */
    #tools-view-calendar .list-header-top,
    #tools-view-contacts .list-header-top { flex-wrap: wrap; row-gap: 8px; }
  }

  @media (max-width: 480px) {
    .tools-cal-cell { min-height: 38px; }
    .tools-cal-evt-more { display: none; }
    .tools-cal-evt { white-space: normal; -webkit-line-clamp: 1; }
    #cal-month-label { font-size: 13px; min-width: 0; }
  }

  /* Administration */
  .tools-adm-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 8px; margin-bottom: 16px; }
  .tools-adm-stat-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px; }
  .tools-adm-stat-value { font-size: 20px; font-weight: 800; color: var(--accent); }
  .tools-adm-stat-label { font-size: 10px; color: var(--text-muted); text-transform: uppercase; margin-top: 2px; }

  .tools-adm-tabs { display: flex; gap: 2px; margin-bottom: 12px; border-bottom: 1px solid var(--border); flex-wrap: wrap; }
  .tools-adm-tab { padding: 7px 12px; border: none; background: transparent; color: var(--text-muted); font-size: 11px; font-weight: 700;
    cursor: pointer; font-family: 'Sora', sans-serif; border-bottom: 2px solid transparent; }
  .tools-adm-tab.active { color: var(--accent); border-bottom-color: var(--accent); }

  table.tools-adm-table { width: 100%; border-collapse: collapse; font-size: 11px; }
  table.tools-adm-table th { text-align: left; padding: 7px 8px; color: var(--text-muted); font-weight: 700; text-transform: uppercase;
    font-size: 9px; border-bottom: 1px solid var(--border); }
  table.tools-adm-table td { padding: 7px 8px; border-bottom: 1px solid var(--border); color: var(--text-1); vertical-align: middle; }
  table.tools-adm-table tr:last-child td { border-bottom: none; }
  .tools-adm-badge { display: inline-block; padding: 2px 7px; border-radius: 20px; font-size: 9px; font-weight: 700; white-space: nowrap; }
  .tools-adm-badge.live, .tools-adm-badge.active, .tools-adm-badge.ok { background: rgba(34,197,94,.15); color: #22c55e; }
  .tools-adm-badge.scheduled { background: var(--accent-lo); color: var(--accent); }
  .tools-adm-badge.suspended, .tools-adm-badge.fail { background: rgba(248,113,113,.15); color: #f87171; }
  .tools-adm-mini-btn { padding: 4px 8px; border-radius: 6px; border: 1px solid var(--border); background: transparent;
    color: var(--text-1); font-size: 10px; font-weight: 700; cursor: pointer; margin-right: 4px; white-space: nowrap; }
  .tools-adm-mini-btn.danger { border-color: rgba(248,113,113,.4); color: #f87171; }

  @media (max-width: 768px) {
    table.tools-adm-table { font-size: 10px; }
    table.tools-adm-table th, table.tools-adm-table td { padding: 6px; }
  }
</style>
