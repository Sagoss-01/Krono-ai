<!-- views/components/ai-assistant.ejs -->
<!-- ══ MODE ASSISTANT IA (conversations persistées + cartes d'action) ════════ -->
<div id="mode-ai" class="mode-container" style="display:none;">

  <aside class="ai-side" id="ai-side" aria-label="Conversations">
    <div class="ai-side-head">
      <span class="ai-side-title">Conversations</span>
      <button type="button" class="ai-new-btn" onclick="AIAssistant.newConversation()">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Nouvelle
      </button>
    </div>
    <nav class="ai-conv-list" id="ai-conv-list" aria-label="Liste des conversations"></nav>
  </aside>

  <section class="ai-main">
    <header class="ai-main-head">
      <button type="button" class="icon-btn ai-side-toggle" onclick="AIAssistant.toggleSide()" title="Conversations" aria-label="Conversations">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <div class="ai-head-badge">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3z"/><path d="M19 15l.9 2.1L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9L19 15z"/></svg>
      </div>
      <div class="ai-head-text">
        <div class="ai-head-title" id="ai-title">Assistant IA</div>
        <div class="ai-head-sub">E-mails, agenda, contacts et réunions</div>
      </div>
      <button type="button" class="icon-btn ai-prefs-btn" onclick="AIAssistant.openPrefs()" title="Préférences de l'assistant" aria-label="Préférences de l'assistant">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h0a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51h0a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v0a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
      </button>
    </header>

    <div class="ai-scroll" id="ai-scroll">
      <div class="ai-thread" id="ai-thread" role="log" aria-live="polite" aria-label="Conversation avec l'assistant"></div>
    </div>

    <div class="ai-composer-wrap">
      <div class="ai-composer">
        <textarea id="ai-input" rows="1" maxlength="4000" aria-label="Votre message à l'assistant" placeholder="Demandez quelque chose… ex : « Écris un e-mail à Marie pour reporter la réunion »" onkeydown="AIAssistant.onKey(event)" oninput="AIAssistant.autoGrow(this)"></textarea>
        <button type="button" id="ai-mic" class="ai-mic" onclick="AIAssistant.toggleDictation()" title="Dicter votre message" aria-label="Dicter votre message" aria-pressed="false">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
        </button>
        <button type="button" id="ai-send" class="ai-send" onclick="AIAssistant.send()" title="Envoyer" aria-label="Envoyer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        </button>
      </div>
      <div class="ai-foot">L'IA peut se tromper : vérifiez avant de confirmer. Aucune action n'est exécutée sans votre clic.</div>
    </div>
  </section>
</div>
