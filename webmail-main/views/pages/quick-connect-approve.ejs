<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <meta name="csrf-token" content="<%= csrfToken || '' %>">
  <link rel="icon" href="/favicon.ico" type="image/x-icon" />
  <link rel="stylesheet" href="/css/style.css" />
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    * { box-sizing: border-box; font-family: 'Sora', sans-serif; }
    body { margin: 0; background: #060d1a; color: #f1f5f9; min-height: 100vh; display:flex; align-items:center; justify-content:center; padding: 20px; }
    .card { width:100%; max-width: 420px; background: #0f172a; border: 1px solid rgba(3,92,128,.18); border-radius: 18px; padding: 30px; text-align: center; }
    h1 { font-size: 19px; margin: 0 0 10px; }
    p.desc { font-size: 13px; color: #94a3b8; line-height: 1.6; margin: 0 0 20px; }
    .device-box { background: rgba(245,158,11,.08); border: 1px solid rgba(245,158,11,.3); border-radius: 12px; padding: 16px; margin-bottom: 22px; text-align:left; }
    .device-box .row { font-size: 12px; color: #fbbf24; line-height: 1.9; }
    .device-box .row strong { color: #fef3c7; }
    .actions { display: flex; gap: 10px; }
    .btn { flex: 1; padding: 12px; border-radius: 10px; border: none; font-size: 13px; font-weight: 700; cursor: pointer; }
    .btn.approve { background: linear-gradient(135deg,#22c55e,#16a34a); color: #fff; }
    .btn.deny { background: transparent; border: 1px solid rgba(248,113,113,.35); color: #f87171; }
    .msg { margin-top: 16px; font-size: 13px; padding: 10px; border-radius: 10px; display:none; }
    .msg.ok { display:block; background: rgba(34,197,94,.12); color: #86efac; }
    .msg.err { display:block; background: rgba(248,113,113,.1); color: #fca5a5; }
  </style>
</head>
<body>
  <div class="card">
    <% if (!valid) { %>
      <h1>⚠️ Lien invalide</h1>
      <p class="desc">Ce lien de connexion rapide est invalide, a expiré, ou a déjà été utilisé.</p>
    <% } else { %>
      <h1>Autoriser cet appareil ?</h1>
      <p class="desc">
        Un appareil demande à se connecter à <strong>ton compte</strong>, sans mot de passe.
        Vérifie que c'est bien toi avant d'accepter.
      </p>
      <div class="device-box">
        <div class="row"><strong>Appareil :</strong> <%= requesterUa || 'Inconnu' %></div>
        <div class="row"><strong>Adresse IP :</strong> <%= requesterIp || 'Inconnue' %></div>
      </div>
      <div class="actions">
        <button class="btn deny" onclick="decide('deny')">Refuser</button>
        <button class="btn approve" onclick="decide('approve')">✅ Autoriser</button>
      </div>
      <div id="msg" class="msg"></div>
    <% } %>
  </div>

  <script>
    const TOKEN = <%- JSON.stringify(token) %>;
    function getCsrfToken() {
      return document.querySelector('meta[name="csrf-token"]')?.content || '';
    }
    async function decide(decision) {
      const msg = document.getElementById('msg');
      const res = await fetch('/api/quick-connect/decide', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': getCsrfToken() },
        body: JSON.stringify({ token: TOKEN, decision })
      }).then(r => r.json());

      msg.className = 'msg ' + (res.ok ? 'ok' : 'err');
      msg.textContent = res.ok
        ? (decision === 'approve' ? "✅ Appareil autorisé — il va se connecter automatiquement." : 'Demande refusée.')
        : (res.error || 'Erreur');
    }
  </script>
</body>
</html>
