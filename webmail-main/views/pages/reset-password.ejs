<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <meta name="csrf-token" content="<%= csrfToken || '' %>">
  <link rel="icon" href="/favicon.ico" type="image/x-icon" />
  <link rel="stylesheet" href="/css/style.css" />
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Sora', sans-serif; }
    body { background: #060d1a; color: #f1f5f9; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; }
    .card { width: 100%; max-width: 420px; background: #0f172a; border: 1px solid rgba(3,92,128,.18); border-radius: 18px; padding: 34px; }
    h1 { font-size: 20px; margin-bottom: 8px; }
    p.desc { font-size: 13px; color: #94a3b8; line-height: 1.6; margin-bottom: 24px; }
    label { font-size: 12px; font-weight: 700; color: #94a3b8; display: block; margin-bottom: 6px; text-transform: uppercase; letter-spacing: .04em; }
    .inp { width: 100%; padding: 12px 14px; border-radius: 10px; border: 1px solid rgba(3,92,128,.25); background: #111c31; color: #f1f5f9; font-size: 14px; outline: none; margin-bottom: 16px; }
    .inp:focus { border-color: #035c80; }
    button.submit { width: 100%; padding: 13px; border-radius: 10px; border: none; background: linear-gradient(135deg,#035c80,#024a6a); color: #fff; font-size: 14px; font-weight: 700; cursor: pointer; }
    button.submit:disabled { opacity: .6; cursor: default; }
    .msg { margin-top: 16px; font-size: 13px; line-height: 1.6; padding: 12px 14px; border-radius: 10px; display: none; }
    .msg.ok { display: block; background: rgba(34,197,94,.12); border: 1px solid rgba(34,197,94,.3); color: #86efac; }
    .msg.err { display: block; background: rgba(248,113,113,.1); border: 1px solid rgba(248,113,113,.3); color: #fca5a5; }
  </style>
</head>
<body>
  <div class="card">
    <h1>Nouveau mot de passe</h1>
    <p class="desc">Choisissez un nouveau mot de passe pour votre boîte mail (8 caractères minimum).</p>

    <% if (!token) { %>
      <div class="msg err">Lien invalide. Refaites une demande depuis <a href="/forgot-password" style="color:#7dd3fc;">mot de passe oublié</a>.</div>
    <% } else { %>
      <form id="reset-form">
        <input type="hidden" id="reset-token" value="<%= token %>">
        <label>Nouveau mot de passe</label>
        <input type="password" id="reset-password" class="inp" required minlength="8" autocomplete="new-password">
        <label>Confirmer le mot de passe</label>
        <input type="password" id="reset-confirm" class="inp" required minlength="8" autocomplete="new-password">
        <button type="submit" class="submit" id="reset-btn">Réinitialiser le mot de passe</button>
      </form>
      <div id="reset-msg" class="msg"></div>
    <% } %>
  </div>

  <script>
    function getCsrfToken() {
      return document.querySelector('meta[name="csrf-token"]')?.content || '';
    }
    const form = document.getElementById('reset-form');
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = document.getElementById('reset-btn');
        const msg = document.getElementById('reset-msg');
        const token = document.getElementById('reset-token').value;
        const password = document.getElementById('reset-password').value;
        const confirmPassword = document.getElementById('reset-confirm').value;

        if (password !== confirmPassword) {
          msg.className = 'msg err';
          msg.textContent = 'Les mots de passe ne correspondent pas.';
          return;
        }

        btn.disabled = true;
        btn.textContent = 'Mise à jour…';
        msg.className = 'msg';
        try {
          const res = await fetch('/api/reset-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': getCsrfToken() },
            body: JSON.stringify({ token, password, confirmPassword })
          });
          const data = await res.json();
          if (data.ok) {
            msg.className = 'msg ok';
            msg.textContent = 'Mot de passe mis à jour ! Redirection vers la connexion…';
            setTimeout(() => { window.location.href = data.redirect || '/login'; }, 1500);
          } else {
            msg.className = 'msg err';
            msg.textContent = data.error || 'Erreur lors de la mise à jour.';
          }
        } catch (err) {
          msg.className = 'msg err';
          msg.textContent = 'Erreur réseau, réessayez.';
        } finally {
          btn.disabled = false;
          btn.textContent = 'Réinitialiser le mot de passe';
        }
      });
    }
  </script>
</body>
</html>
