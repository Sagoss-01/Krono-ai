<!DOCTYPE html>
<html lang="fr" data-theme="dark">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= title %>
  </title>
  <meta name="description" content="TechSphere Webmail — Messagerie professionnelle sécurisée" />
  <meta property="og:title" content="TechSphere Webmail" />
  <meta property="og:description" content="Messagerie professionnelle sécurisée — netiify.cloud" />
  <meta property="og:image" content="/logo.png" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="/logo.png" />
  <link rel="icon" href="/favicon.ico" type="image/x-icon" />
  <link rel="apple-touch-icon" href="/logo.png" />
  <meta name="theme-color" content="#035c80" />
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800;900&display=swap"
    rel="stylesheet" />
  <style>
    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Sora', sans-serif;
    }

    html,
    body {
      height: 100%;
    }

    body {
      background: #050c1a;
      color: #f1f5f9;
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* ── BG ── */
    .bg {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      background:
        radial-gradient(ellipse 70% 55% at 5% 15%, rgba(3, 92, 128, 0.14) 0%, transparent 65%),
        radial-gradient(ellipse 50% 45% at 95% 85%, rgba(139, 92, 246, 0.09) 0%, transparent 60%),
        radial-gradient(ellipse 40% 30% at 60% 40%, rgba(6, 182, 212, 0.05) 0%, transparent 55%);
    }

    .grid {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      background-image:
        linear-gradient(rgba(3, 92, 128, 0.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(3, 92, 128, 0.035) 1px, transparent 1px);
      background-size: 56px 56px;
    }

    /* ── NAV ── */
    nav {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 48px;
      height: 64px;
      background: rgba(5, 12, 26, 0.85);
      border-bottom: 1px solid rgba(3, 92, 128, 0.08);
      backdrop-filter: blur(24px);
    }

    .nav-logo {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
    }

    .nav-logo-ico {
      width: 38px;
      height: 38px;
      border-radius: 11px;
      flex-shrink: 0;
      background: linear-gradient(135deg, #035c80, #8b5cf6);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 16px rgba(3, 92, 128, 0.35);
    }

    .nav-logo-name {
      font-weight: 800;
      font-size: 17px;
      color: #f1f5f9;
    }

    .nav-logo-tag {
      font-size: 10px;
      color: #334155;
      letter-spacing: .1em;
      text-transform: uppercase;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .btn-ghost {
      padding: 8px 18px;
      border-radius: 9px;
      font-size: 13px;
      font-weight: 600;
      background: transparent;
      border: 1px solid rgba(3, 92, 128, 0.2);
      color: #94a3b8;
      cursor: pointer;
      text-decoration: none;
      transition: all .15s;
      display: inline-flex;
      align-items: center;
    }

    .btn-ghost:hover {
      background: rgba(3, 92, 128, 0.08);
      color: #4db8d8;
      border-color: rgba(3, 92, 128, 0.35);
    }

    .btn-primary {
      padding: 8px 20px;
      border-radius: 9px;
      font-size: 13px;
      font-weight: 700;
      background: linear-gradient(135deg, #035c80, #024a6a);
      border: none;
      color: white;
      cursor: pointer;
      text-decoration: none;
      transition: all .2s;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      box-shadow: 0 4px 16px rgba(3, 92, 128, 0.28);
    }

    .btn-primary:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 24px rgba(3, 92, 128, 0.38);
    }

    /* ── HERO ── */
    .hero {
      position: relative;
      z-index: 5;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 96px 24px 72px;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 16px;
      border-radius: 999px;
      margin-bottom: 36px;
      background: rgba(3, 92, 128, 0.08);
      border: 1px solid rgba(3, 92, 128, 0.18);
      font-size: 12px;
      font-weight: 600;
      color: #4db8d8;
      letter-spacing: .06em;
    }

    .badge-dot {
      width: 6px;
      height: 6px;
      background: #22c55e;
      border-radius: 50%;
      animation: blink 2s infinite;
    }

    @keyframes blink {

      0%,
      100% {
        opacity: 1;
        transform: scale(1)
      }

      50% {
        opacity: .5;
        transform: scale(1.5)
      }
    }

    h1 {
      font-size: clamp(40px, 7vw, 78px);
      font-weight: 900;
      line-height: 1.06;
      letter-spacing: -.03em;
      max-width: 820px;
      margin-bottom: 26px;
    }

    h1 .white {
      color: #f1f5f9;
    }

    h1 .blue {
      background: linear-gradient(110deg, #035c80 0%, #8b5cf6 50%, #06b6d4 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-desc {
      font-size: 17px;
      color: #64748b;
      line-height: 1.7;
      max-width: 500px;
      margin-bottom: 48px;
    }

    .hero-cta {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      justify-content: center;
      margin-bottom: 72px;
    }

    .btn-cta-primary {
      padding: 15px 36px;
      border-radius: 13px;
      font-size: 15px;
      font-weight: 800;
      background: linear-gradient(135deg, #035c80, #024a6a);
      border: none;
      color: white;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 9px;
      box-shadow: 0 8px 32px rgba(3, 92, 128, 0.35);
      transition: all .2s;
      letter-spacing: -.01em;
    }

    .btn-cta-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 40px rgba(3, 92, 128, 0.42);
    }

    .btn-cta-outline {
      padding: 15px 30px;
      border-radius: 13px;
      font-size: 15px;
      font-weight: 600;
      background: transparent;
      border: 1px solid rgba(3, 92, 128, 0.22);
      color: #94a3b8;
      cursor: pointer;
      text-decoration: none;
      transition: all .2s;
      display: inline-flex;
      align-items: center;
      gap: 9px;
    }

    .btn-cta-outline:hover {
      background: rgba(3, 92, 128, 0.07);
      color: #4db8d8;
      border-color: rgba(3, 92, 128, 0.38);
    }

    /* ── PREVIEW CARD (simulated mailbox) ── */
    .preview-wrap {
      width: 100%;
      max-width: 820px;
      border-radius: 20px;
      overflow: hidden;
      border: 1px solid rgba(3, 92, 128, 0.15);
      box-shadow: 0 32px 80px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(255, 255, 255, 0.03);
      background: #0c1526;
    }

    .preview-bar {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 12px 16px;
      background: #0a1020;
      border-bottom: 1px solid rgba(3, 92, 128, 0.1);
    }

    .dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
    }

    .preview-url {
      flex: 1;
      margin: 0 12px;
      padding: 4px 12px;
      border-radius: 6px;
      background: rgba(3, 92, 128, 0.06);
      border: 1px solid rgba(3, 92, 128, 0.1);
      font-size: 11px;
      color: #475569;
      font-family: monospace;
      text-align: center;
    }

    .preview-body {
      display: flex;
      height: 300px;
    }

    .preview-sidebar {
      width: 180px;
      border-right: 1px solid rgba(3, 92, 128, 0.08);
      padding: 12px 8px;
    }

    .preview-folder {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 7px 10px;
      border-radius: 7px;
      font-size: 11px;
      color: #475569;
      margin-bottom: 2px;
    }

    .preview-folder.act {
      background: rgba(3, 92, 128, 0.12);
      color: #4db8d8;
    }

    .preview-folder svg {
      width: 12px;
      height: 12px;
      opacity: .7;
    }

    .preview-list {
      width: 200px;
      border-right: 1px solid rgba(3, 92, 128, 0.08);
      overflow: hidden;
    }

    .preview-item {
      padding: 10px 12px;
      border-bottom: 1px solid rgba(3, 92, 128, 0.06);
    }

    .preview-item-from {
      font-size: 10px;
      font-weight: 700;
      color: #4db8d8;
      margin-bottom: 3px;
    }

    .preview-item-subj {
      font-size: 11px;
      color: #475569;
    }

    .preview-item.first {
      background: rgba(3, 92, 128, 0.08);
    }

    .preview-item.first .preview-item-from {
      color: #7dd4e8;
    }

    .preview-item.first .preview-item-subj {
      color: #cbd5e1;
    }

    .preview-view {
      flex: 1;
      padding: 14px 18px;
    }

    .preview-view-subj {
      font-size: 13px;
      font-weight: 700;
      color: #cbd5e1;
      margin-bottom: 10px;
    }

    .preview-view-line {
      height: 8px;
      border-radius: 4px;
      background: rgba(3, 92, 128, 0.08);
      margin-bottom: 6px;
    }

    /* ── STATS ── */
    .stats {
      position: relative;
      z-index: 5;
      display: flex;
      justify-content: center;
      gap: 0;
      max-width: 680px;
      margin: 0 auto 80px;
      background: rgba(12, 21, 38, 0.7);
      border: 1px solid rgba(3, 92, 128, 0.1);
      border-radius: 16px;
      overflow: hidden;
    }

    .stat {
      flex: 1;
      text-align: center;
      padding: 24px 16px;
      border-right: 1px solid rgba(3, 92, 128, 0.08);
    }

    .stat:last-child {
      border-right: none;
    }

    .stat-num {
      font-size: 28px;
      font-weight: 900;
      color: #f1f5f9;
      letter-spacing: -.02em;
    }

    .stat-lbl {
      font-size: 11px;
      color: #475569;
      margin-top: 4px;
      font-weight: 500;
    }

    /* ── FEATURES ── */
    .section {
      position: relative;
      z-index: 5;
      padding: 0 48px 100px;
      max-width: 1080px;
      margin: 0 auto;
    }

    .section-title {
      text-align: center;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: #035c80;
      margin-bottom: 14px;
    }

    .section-h2 {
      text-align: center;
      font-size: clamp(26px, 3.5vw, 38px);
      font-weight: 800;
      color: #f1f5f9;
      letter-spacing: -.02em;
      margin-bottom: 48px;
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 16px;
    }

    .feat {
      background: rgba(12, 21, 38, 0.7);
      border: 1px solid rgba(3, 92, 128, 0.09);
      border-radius: 14px;
      padding: 24px;
      transition: all .2s;
      backdrop-filter: blur(8px);
    }

    .feat:hover {
      border-color: rgba(3, 92, 128, 0.22);
      transform: translateY(-3px);
      box-shadow: 0 16px 40px rgba(0, 0, 0, .3);
    }

    .feat-ico {
      width: 42px;
      height: 42px;
      border-radius: 11px;
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .feat-title {
      font-size: 15px;
      font-weight: 700;
      color: #f1f5f9;
      margin-bottom: 7px;
    }

    .feat-desc {
      font-size: 13px;
      color: #64748b;
      line-height: 1.6;
    }

    /* ── FOOTER ── */
    footer {
      position: relative;
      z-index: 5;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 22px 48px;
      border-top: 1px solid rgba(3, 92, 128, 0.07);
      font-size: 12px;
      color: #334155;
      flex-wrap: wrap;
      gap: 12px;
    }

    footer a {
      color: #035c80;
      text-decoration: none;
    }

    @media (max-width: 640px) {
      nav {
        padding: 0 20px;
      }

      .hero {
        padding: 64px 20px 48px;
      }

      .section {
        padding: 0 20px 60px;
      }

      footer {
        padding: 18px 20px;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }

      .stats {
        flex-direction: column;
      }

      .stat {
        border-right: none;
        border-bottom: 1px solid rgba(3, 92, 128, 0.08);
      }

      .stat:last-child {
        border-bottom: none;
      }
    }
  </style>
</head>

<body>
  <div class="bg"></div>
  <div class="grid"></div>

  <!-- NAV -->
  <nav>
    <a href="/" class="nav-logo">
      <div class="nav-logo-ico">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="white">
          <path
            d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z" />
        </svg>
      </div>
      <div>
        <div class="nav-logo-name">TechSphere</div>
        <div class="nav-logo-tag">Webmail</div>
      </div>
    </a>
    <div class="nav-actions">
      <a href="/login" class="btn-ghost">Connexion</a>
      <a href="/login" class="btn-primary">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path
            d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z" />
        </svg>
        Accéder à ma boîte
      </a>
    </div>
  </nav>

  <!-- HERO -->
  <div class="hero">
    <div class="badge">
      <span class="badge-dot"></span>
      Interface mail de TechSphere · netiify.cloud
    </div>

    <h1>
      <span class="white">Votre messagerie</span><br />
      <span class="blue">professionnelle</span><br />
      <span class="white">à portée de main</span>
    </h1>

    <p class="hero-desc">
      TechSphere Webmail est l'interface officielle de messagerie pour les adresses
      <strong style="color:#4db8d8;">@netiify.cloud</strong>.
      Accédez à vos emails de façon sécurisée, depuis n'importe quel appareil.
    </p>

    <div class="hero-cta">
      <a href="/login" class="btn-cta-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
          <polyline points="10 17 15 12 10 7" />
          <line x1="15" y1="12" x2="3" y2="12" />
        </svg>
        Se connecter
      </a>
      <a href="/register" class="btn-cta-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
          stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
          <circle cx="9" cy="7" r="4" />
          <line x1="19" y1="8" x2="19" y2="14" />
          <line x1="22" y1="11" x2="16" y2="11" />
        </svg>
        S'inscrire
      </a>
      <!--  <a href="#features" class="btn-cta-outline">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        Découvrir les fonctionnalités
      </a> -->
    </div>

    <!-- Simulated preview -->
    <div class="preview-wrap">
      <div class="preview-bar">
        <div class="dot" style="background:#ef4444;"></div>
        <div class="dot" style="background:#f59e0b;"></div>
        <div class="dot" style="background:#22c55e;"></div>
        <div class="preview-url">mail.netiify.cloud · TechSphere Webmail</div>
      </div>
      <div class="preview-body">
        <div class="preview-sidebar">
          <div class="preview-folder act">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 12h-6l-2 3h-4l-2-3H2" />
              <path
                d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z" />
            </svg>
            Boîte de réception
          </div>
          <div class="preview-folder">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="22" y1="2" x2="11" y2="13" />
              <polygon points="22 2 15 22 11 13 2 9 22 2" />
            </svg>
            Envoyés
          </div>
          <div class="preview-folder">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
            </svg>
            Brouillons
          </div>
          <div class="preview-folder">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="3 6 5 6 21 6" />
              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
            </svg>
            Corbeille
          </div>
        </div>
        <div class="preview-list">
          <div class="preview-item first">
            <div class="preview-item-from">Nouveau message</div>
            <div class="preview-item-subj">Bienvenue sur TechSphere</div>
          </div>
          <div class="preview-item">
            <div class="preview-item-from">support@netiify.cloud</div>
            <div class="preview-item-subj">Votre compte est activé</div>
          </div>
          <div class="preview-item">
            <div class="preview-item-from">no-reply@techsphere.app</div>
            <div class="preview-item-subj">Rapport hebdomadaire</div>
          </div>
          <div class="preview-item">
            <div class="preview-item-from">team@techsphere.app</div>
            <div class="preview-item-subj">Réunion de l'équipe</div>
          </div>
          <div class="preview-item">
            <div class="preview-item-from">admin@netiify.cloud</div>
            <div class="preview-item-subj">Maintenance serveur</div>
          </div>
        </div>
        <div class="preview-view">
          <div class="preview-view-subj">Bienvenue sur TechSphere Webmail</div>
          <div class="preview-view-line" style="width:100%;opacity:.6;"></div>
          <div class="preview-view-line" style="width:80%;opacity:.4;"></div>
          <div class="preview-view-line" style="width:90%;opacity:.3;"></div>
          <div class="preview-view-line" style="width:60%;opacity:.2;"></div>
          <div class="preview-view-line" style="width:75%;margin-top:14px;opacity:.4;"></div>
          <div class="preview-view-line" style="width:85%;opacity:.3;"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- STATS -->
  <div style="position:relative;z-index:5;padding:0 24px;display:flex;justify-content:center;margin-bottom:80px;">
    <div class="stats">
      <div class="stat">
        <div class="stat-num">SSL</div>
        <div class="stat-lbl">IMAP chiffré</div>
      </div>
      <div class="stat">
        <div class="stat-num">TLS</div>
        <div class="stat-lbl">SMTP sécurisé</div>
      </div>
      <div class="stat">
        <div class="stat-num">30s</div>
        <div class="stat-lbl">Polling temps réel</div>
      </div>
      <div class="stat">
        <div class="stat-num">∞</div>
        <div class="stat-lbl">Multi-comptes</div>
      </div>
    </div>
  </div>

  <!-- FEATURES -->
  <div id="features" class="section">
    <div class="section-title">Fonctionnalités</div>
    <div class="section-h2">Tout ce dont vous avez besoin</div>
    <div class="features-grid">
      <div class="feat">
        <div class="feat-ico" style="background:rgba(3,92,128,0.12);">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#035c80" stroke-width="2">
            <path d="M22 12h-6l-2 3h-4l-2-3H2" />
            <path
              d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z" />
          </svg>
        </div>
        <div class="feat-title">Réception temps réel</div>
        <div class="feat-desc">Nouveaux emails détectés automatiquement via Socket.IO avec notification sonore.</div>
