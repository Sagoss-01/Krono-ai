<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <meta name="description" content="TechSphere Webmail — Création de compte" />
  <link rel="icon" href="/favicon.ico" type="image/x-icon" />
  <link rel="apple-touch-icon" href="/logo.png" />
  <meta name="csrf-token" content="<%= csrfToken || '' %>">
  <meta name="theme-color" content="#035c80" />
  <link rel="stylesheet" href="/css/style.css" />
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Sora', sans-serif; }
    body { background: #060d1a; color: #f1f5f9; min-height: 100vh; display: flex; overflow: hidden; }
    .left-panel {
      width: 55%;
      background: linear-gradient(145deg, #0b1628 0%, #060d1a 60%);
      display: flex; flex-direction: column; justify-content: space-between;
      padding: 40px 48px; position: relative; overflow: hidden;
    }
    .left-panel::before {
      content: ''; position: absolute; top: -200px; left: -200px; width: 600px; height: 600px; border-radius: 50%;
      background: radial-gradient(circle, rgba(3,92,128,0.15), transparent 70%);
      pointer-events: none;
    }
    .left-panel::after {
      content: ''; position: absolute; bottom: -150px; right: -100px; width: 400px; height: 400px; border-radius: 50%;
      background: radial-gradient(circle, rgba(139,92,246,0.08), transparent 70%);
      pointer-events: none;
    }
    .grid-overlay {
      position: absolute; inset: 0; pointer-events: none;
      background-image:
        linear-gradient(rgba(3,92,128,0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(3,92,128,0.05) 1px, transparent 1px);
      background-size: 50px 50px;
    }
    .left-logo { display: flex; align-items: center; gap: 12px; position: relative; z-index: 2; text-decoration: none; }
    .left-logo-icon {
      width: 40px; height: 40px; border-radius: 12px; background: linear-gradient(135deg, #035c80, #8b5cf6);
      display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 20px rgba(3,92,128,0.35);
    }
    .left-logo-name { font-weight: 800; font-size: 18px; color: #f1f5f9; }
    .left-logo-sub { font-size: 10px; color: #475569; letter-spacing: .1em; text-transform: uppercase; }
    .left-main { position: relative; z-index: 2; }
    .left-main h2 {
      font-size: clamp(28px, 3vw, 42px); font-weight: 800; line-height: 1.15; letter-spacing: -.02em; margin-bottom: 16px;
      background: linear-gradient(135deg, #f1f5f9, #64748b);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    }
    .left-main h2 span {
      background: linear-gradient(135deg, #035c80, #8b5cf6);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    }
    .left-main p { font-size: 14px; color: #475569; line-height: 1.7; max-width: 410px; }
    .left-features { position: relative; z-index: 2; display: flex; flex-direction: column; gap: 12px; }
    .feat-row {
      display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-radius: 12px;
      background: rgba(15,23,42,0.5); border: 1px solid rgba(3,92,128,0.10);
    }
    .feat-icon {
      width: 34px; height: 34px; border-radius: 9px; flex-shrink: 0; display: flex; align-items: center; justify-content: center;
    }
    .feat-text { font-size: 13px; color: #94a3b8; line-height: 1.4; }
    .feat-text strong { color: #cbd5e1; display: block; font-size: 12px; margin-bottom: 2px; }

    .right-panel {
      width: 45%; background: #0f172a; display: flex; flex-direction: column; justify-content: center; align-items: center;
      padding: 48px 40px; border-left: 1px solid rgba(3,92,128,0.12); overflow-y: auto;
    }
    .form-wrap { width: 100%; max-width: 420px; }
    .form-title { font-size: 26px; font-weight: 800; color: #f1f5f9; margin-bottom: 6px; }
    .form-sub { font-size: 13px; color: #475569; margin-bottom: 24px; }

    .alert-error, .alert-info {
      display: none; align-items: center; gap: 10px; padding: 12px 14px; border-radius: 10px;
      margin-bottom: 18px; font-size: 13px;
    }
    .alert-error { background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.2); color: #f87171; }
    .alert-info { background: rgba(3,92,128,0.10); border: 1px solid rgba(3,92,128,0.22); color: #7dd3fc; }

    .wizard-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 22px; }
    .wizard-step {
      padding: 10px 12px; border-radius: 12px; border: 1px solid rgba(3,92,128,0.15);
      background: rgba(15,23,42,0.55); transition: all .2s;
    }
    .wizard-step.active {
      background: rgba(3,92,128,0.12);
      border-color: rgba(3,92,128,0.35);
      box-shadow: 0 0 0 3px rgba(3,92,128,0.08);
    }
    .wizard-step.done {
      border-color: rgba(34,197,94,0.28);
      background: rgba(34,197,94,0.08);
    }
    .wizard-step-num {
      width: 22px; height: 22px; border-radius: 999px; display: flex; align-items: center; justify-content: center;
      font-size: 11px; font-weight: 800; color: white; background: linear-gradient(135deg, #035c80, #8b5cf6); margin-bottom: 8px;
    }
    .wizard-step-title { font-size: 12px; font-weight: 700; color: #e2e8f0; }
    .wizard-step-sub { font-size: 11px; color: #64748b; margin-top: 3px; }

    .wizard-panel { display: none; animation: fadeUp .18s ease; }
    .wizard-panel.active { display: block; }

    .field { margin-bottom: 18px; }
    .field label {
      display: block; font-size: 11px; font-weight: 700; letter-spacing: .08em;
      text-transform: uppercase; color: #475569; margin-bottom: 7px;
    }
    .inp, .select {
      width: 100%; padding: 11px 14px; border-radius: 10px; font-size: 14px;
      background: rgba(15,23,42,0.8); border: 1px solid rgba(3,92,128,0.25);
      color: #f1f5f9; outline: none; transition: all .2s;
    }
    .inp:focus, .select:focus {
      border-color: rgba(3,92,128,0.55);
      box-shadow: 0 0 0 3px rgba(3,92,128,0.10);
    }
    .inp::placeholder { color: #334155; }

    .mail-preview-card {
      padding: 14px; border-radius: 12px; background: rgba(15,23,42,0.65);
      border: 1px solid rgba(3,92,128,0.16); margin-bottom: 16px;
    }
    .mail-preview-label {
      font-size: 11px; font-weight: 700; letter-spacing: .08em;
      text-transform: uppercase; color: #64748b; margin-bottom: 8px;
    }
    .mail-preview-value {
      font-size: 14px; font-weight: 700; color: #7dd3fc;
      font-family: 'JetBrains Mono', monospace; word-break: break-word;
    }
    .mail-preview-help { font-size: 12px; color: #64748b; margin-top: 8px; line-height: 1.55; }

    .split-mail {
      display: flex; border-radius: 10px; overflow: hidden; border: 1px solid rgba(3,92,128,0.25);
      background: rgba(15,23,42,0.8);
    }
    .split-mail input {
      flex: 1; background: transparent; border: none; outline: none; padding: 11px 14px; font-size: 14px;
      color: #f1f5f9; font-family: 'JetBrains Mono', monospace;
    }
    .split-mail .domain {
      padding: 11px 14px; font-size: 13px; font-weight: 600; color: #035c80;
      background: rgba(3,92,128,0.08); border-left: 1px solid rgba(3,92,128,0.18);
      white-space: nowrap; user-select: none; font-family: 'JetBrains Mono', monospace;
    }

    .pwd-wrap { position: relative; }
    .pwd-eye {
      position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
      background: none; border: none; cursor: pointer; color: #475569;
      display: flex; align-items: center; padding: 4px;
    }

    .wizard-actions { display: flex; gap: 10px; margin-top: 8px; }
    .btn {
      flex: 1; padding: 13px; border-radius: 11px; border: none; cursor: pointer;
      font-size: 14px; font-weight: 700; transition: all .2s;
    }
    .btn-secondary {
      background: rgba(15,23,42,0.8);
      border: 1px solid rgba(3,92,128,0.18);
      color: #cbd5e1;
    }
    .btn-secondary:hover { background: rgba(3,92,128,0.08); }
    .btn-primary {
      color: white; background: linear-gradient(135deg, #035c80, #024a6a);
      box-shadow: 0 6px 24px rgba(3,92,128,0.35);
    }
    .btn-primary:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 8px 32px rgba(3,92,128,0.45); }
    .btn:disabled { opacity: .7; cursor: not-allowed; }

    .form-footer { margin-top: 24px; text-align: center; font-size: 12px; color: #334155; }
    .form-footer a { color: #035c80; text-decoration: none; }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .spin { animation: spin .7s linear infinite; display: inline-block; }

    @media (max-width: 768px) {
      body { flex-direction: column; overflow: auto; }
      .left-panel { width: 100%; padding: 32px 24px 40px; }
      .left-features { display: none; }
      .right-panel {
        width: 100%; border-left: none; border-top: 1px solid rgba(3,92,128,0.12);
        padding: 40px 24px; overflow-y: visible;
      }
      .wizard-steps { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <div class="left-panel">
    <div class="grid-overlay"></div>
    <a href="/" class="left-logo">
      <div class="left-logo-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="white">
          <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
        </svg>
      </div>
      <div>
        <div class="left-logo-name">TechSphere</div>
        <div class="left-logo-sub">Webmail</div>
      </div>
    </a>

    <div class="left-main">
      <h2>Créez votre<br/>adresse<br/><span>professionnelle</span></h2>
      <p>Inscription guidée, proposition intelligente d’adresse email, création automatique de la boîte et connexion immédiate.</p>
    </div>

    <div class="left-features">
      <div class="feat-row">
        <div class="feat-icon" style="background:rgba(3,92,128,0.12);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#035c80" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <div class="feat-text"><strong>Adresse auto-générée</strong>Prénom + nom avec vérification d’unicité</div>
      </div>
      <div class="feat-row">
        <div class="feat-icon" style="background:rgba(34,197,94,0.1);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2">
            <path d="M20 6L9 17l-5-5"/>
          </svg>
        </div>
        <div class="feat-text"><strong>Provisioning automatique</strong>Compte applicatif + boîte mail créés ensemble</div>
      </div>
      <div class="feat-row">
        <div class="feat-icon" style="background:rgba(139,92,246,0.1);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="17 8 12 3 7 8"/>
            <line x1="12" y1="3" x2="12" y2="15"/>
          </svg>
        </div>
        <div class="feat-text"><strong>Connexion immédiate</strong>Après validation, l’utilisateur arrive directement dans <code>/mail</code></div>
      </div>
    </div>
  </div>

  <div class="right-panel">
    <div class="form-wrap">
      <div class="form-title">Créer un compte</div>
      <div class="form-sub">Inscription guidée en 3 étapes</div>

      <div id="register-error" class="alert-error"></div>
      <div id="register-info" class="alert-info"></div>

      <div class="wizard-steps">
        <div class="wizard-step active" data-step="1">
          <div class="wizard-step-num">1</div>
          <div class="wizard-step-title">Infos personnelles</div>
          <div class="wizard-step-sub">Nom et prénom</div>
        </div>
        <div class="wizard-step" data-step="2">
          <div class="wizard-step-num">2</div>
          <div class="wizard-step-title">Profil</div>
          <div class="wizard-step-sub">Genre et naissance</div>
        </div>
        <div class="wizard-step" data-step="3">
          <div class="wizard-step-num">3</div>
          <div class="wizard-step-title">Sécurité</div>
          <div class="wizard-step-sub">Mot de passe et email</div>
        </div>
      </div>

      <form id="register-form" novalidate>
        <div class="wizard-panel active" data-panel="1">
          <div class="field">
            <label for="lastName">Nom</label>
            <input type="text" id="lastName" class="inp" placeholder="Ex: Oussou" required />
          </div>
          <div class="field">
            <label for="firstName">Prénom</label>
            <input type="text" id="firstName" class="inp" placeholder="Ex: Aude" required />
          </div>
          <div class="wizard-actions">
            <button type="button" class="btn btn-primary" id="step1Next">Continuer</button>
          </div>
        </div>

        <div class="wizard-panel" data-panel="2">
          <div class="field">
            <label for="gender">Genre</label>
            <select id="gender" class="select" required>
              <option value="">Sélectionnez</option>
              <option value="Masculin">Masculin</option>
              <option value="Féminin">Féminin</option>
              <option value="Autre">Autre</option>
            </select>
          </div>
          <div class="field">
            <label for="birthDate">Date de naissance</label>
            <input type="date" id="birthDate" class="inp" required />
          </div>
          <div class="wizard-actions">
            <button type="button" class="btn btn-secondary" id="step2Prev">Retour</button>
            <button type="button" class="btn btn-primary" id="step2Next">Continuer</button>
          </div>
        </div>

        <div class="wizard-panel" data-panel="3">
          <div class="mail-preview-card">
            <div class="mail-preview-label">Adresse proposée</div>
            <div class="mail-preview-value" id="mailPreview">Génération…</div>
            <div class="mail-preview-help">
              L’adresse est proposée automatiquement depuis votre prénom et votre nom.
              Vous pouvez encore la modifier avant création.
            </div>
          </div>

          <div class="field">
            <label for="localpart">Adresse email</label>
            <div class="split-mail">
              <input type="text" id="localpart" placeholder="prenomnom" autocomplete="off" />
              <div class="domain">@netiify.cloud</div>
            </div>
          </div>

          <div class="field">
            <label for="password">Mot de passe</label>
            <div class="pwd-wrap">
              <input type="password" id="password" class="inp" placeholder="••••••••" required />
              <button type="button" class="pwd-eye" id="togglePassword1">👁</button>
            </div>
          </div>

          <div class="field">
            <label for="confirmPassword">Confirmer le mot de passe</label>
            <div class="pwd-wrap">
              <input type="password" id="confirmPassword" class="inp" placeholder="••••••••" required />
              <button type="button" class="pwd-eye" id="togglePassword2">👁</button>
            </div>
          </div>

          <div class="wizard-actions">
            <button type="button" class="btn btn-secondary" id="step3Prev">Retour</button>
            <button type="submit" class="btn btn-primary" id="registerSubmit">Créer mon compte</button>
          </div>
        </div>
      </form>

      <div class="form-footer">
        <a href="/login">Déjà un compte ? Se connecter</a>
      </div>
    </div>
  </div>

  <script>
    let currentStep = 1;
    let suggestSeq = 0;
    let suggestTimer = null;

    const els = {
      error: document.getElementById('register-error'),
      info: document.getElementById('register-info'),
      form: document.getElementById('register-form'),
      firstName: document.getElementById('firstName'),
      lastName: document.getElementById('lastName'),
      gender: document.getElementById('gender'),
      birthDate: document.getElementById('birthDate'),
      localpart: document.getElementById('localpart'),
      password: document.getElementById('password'),
      confirmPassword: document.getElementById('confirmPassword'),
      mailPreview: document.getElementById('mailPreview'),
      registerSubmit: document.getElementById('registerSubmit')
    };

    function getCsrfToken() {
      return document.querySelector('meta[name="csrf-token"]')?.content || '';
    }

    function showError(message) {
      els.info.style.display = 'none';
      els.error.textContent = message;
      els.error.style.display = 'flex';
    }

    function showInfo(message) {
      els.error.style.display = 'none';
      els.info.textContent = message;
      els.info.style.display = 'flex';
    }

    function clearAlerts() {
      els.error.style.display = 'none';
      els.info.style.display = 'none';
      els.error.textContent = '';
      els.info.textContent = '';
    }

    function syncSteps() {
      document.querySelectorAll('.wizard-panel').forEach((panel) => {
        panel.classList.toggle('active', Number(panel.dataset.panel) === currentStep);
      });

      document.querySelectorAll('.wizard-step').forEach((step) => {
        const stepNum = Number(step.dataset.step);
        step.classList.toggle('active', stepNum === currentStep);
        step.classList.toggle('done', stepNum < currentStep);
      });
    }

    function validateStep(step) {
      clearAlerts();

      if (step === 1) {
        if (!els.lastName.value.trim()) {
          showError('Le nom est requis');
          return false;
        }
        if (!els.firstName.value.trim()) {
          showError('Le prénom est requis');
          return false;
        }
        return true;
      }

      if (step === 2) {
        if (!els.gender.value) {
          showError('Le genre est requis');
          return false;
        }
        if (!els.birthDate.value) {
          showError('La date de naissance est requise');
          return false;
        }
        return true;
      }

      if (step === 3) {
        if (!els.localpart.value.trim()) {
          showError("L'adresse email est requise");
          return false;
        }
        if (els.password.value.length < 8) {
          showError('Le mot de passe doit contenir au moins 8 caractères');
          return false;
        }
        if (els.password.value !== els.confirmPassword.value) {
          showError('Les mots de passe ne correspondent pas');
          return false;
        }
        return true;
      }

      return true;
    }

    function nextStep() {
      if (!validateStep(currentStep)) return;
      currentStep += 1;
      syncSteps();

      if (currentStep === 3) {
        els.mailPreview.textContent = 'Génération…';
        queueSuggestion(false);
      }
    }

    function prevStep() {
      clearAlerts();
      currentStep -= 1;
      syncSteps();
    }

    function togglePassword(input) {
      input.type = input.type === 'password' ? 'text' : 'password';
    }

    async function fetchSuggestion(manual = false) {
      const firstName = els.firstName.value.trim();
      const lastName = els.lastName.value.trim();
      const localpart = els.localpart.value.trim();

      if (!firstName || !lastName) return;

      const seq = ++suggestSeq;

      try {
        const response = await fetch('/api/register/suggest-email', {
          method: 'POST',
          credentials: 'same-origin',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
            'X-CSRF-Token': getCsrfToken()
          },
          body: JSON.stringify({
            firstName,
            lastName,
            localpart: manual ? localpart : ''
          })
        });

        const data = await response.json();

        if (seq !== suggestSeq) return;

        if (!response.ok || !data.ok) {
          throw new Error(data.error || 'Impossible de proposer une adresse');
        }

        els.localpart.value = data.localpart;
        els.mailPreview.textContent = data.email;

        if (data.generated && manual) {
          showInfo(`Adresse ajustée automatiquement : ${data.email}`);
        } else {
          clearAlerts();
        }
      } catch (err) {
        showError(err.message || "Erreur lors de la suggestion d'adresse");
      }
    }

    function queueSuggestion(manual = false) {
      clearTimeout(suggestTimer);
      suggestTimer = setTimeout(() => fetchSuggestion(manual), manual ? 250 : 0);
    }

    els.firstName.addEventListener('input', () => {
      if (currentStep === 3) queueSuggestion(false);
    });

    els.lastName.addEventListener('input', () => {
      if (currentStep === 3) queueSuggestion(false);
    });

    els.localpart.addEventListener('input', () => {
      const value = els.localpart.value.trim();
      els.mailPreview.textContent = `${value || 'adresse-en-cours'}@netiify.cloud`;
    });

    els.localpart.addEventListener('blur', () => {
      if (els.localpart.value.trim()) {
        queueSuggestion(true);
      }
    });

    document.getElementById('step1Next').addEventListener('click', nextStep);
    document.getElementById('step2Prev').addEventListener('click', prevStep);
    document.getElementById('step2Next').addEventListener('click', nextStep);
    document.getElementById('step3Prev').addEventListener('click', prevStep);
    document.getElementById('togglePassword1').addEventListener('click', () => togglePassword(els.password));
    document.getElementById('togglePassword2').addEventListener('click', () => togglePassword(els.confirmPassword));

    els.form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!validateStep(3)) return;

      els.registerSubmit.disabled = true;
      els.registerSubmit.innerHTML = '<span class="spin">⟳</span> Création…';
      clearAlerts();

      try {
        const payload = {
          firstName: els.firstName.value.trim(),
          lastName: els.lastName.value.trim(),
          gender: els.gender.value,
          birthDate: els.birthDate.value,
          localpart: els.localpart.value.trim(),
          password: els.password.value,
          confirmPassword: els.confirmPassword.value
        };

        const response = await fetch('/api/register', {
          method: 'POST',
          credentials: 'same-origin',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
            'X-CSRF-Token': getCsrfToken()
          },
          body: JSON.stringify(payload)
        });

        const data = await response.json();

        if (!response.ok || !data.ok) {
          throw new Error(data.error || 'Impossible de créer le compte');
        }

        window.location.href = data.redirect || '/mail';
      } catch (err) {
        showError(err.message || 'Impossible de créer le compte');
        els.registerSubmit.disabled = false;
        els.registerSubmit.textContent = 'Créer mon compte';
      }
    });
