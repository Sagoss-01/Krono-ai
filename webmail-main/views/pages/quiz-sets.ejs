<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <meta name="csrf-token" content="<%= csrfToken || '' %>">
  <link rel="icon" href="/favicon.ico" type="image/x-icon" />
  <link rel="stylesheet" href="/css/style.css" />
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    * { box-sizing: border-box; font-family: 'Sora', sans-serif; }
    body { margin: 0; background: #060d1a; color: #f1f5f9; min-height: 100vh; }
    .wrap { max-width: 920px; margin: 0 auto; padding: 32px 20px 80px; }
    .topbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 26px; }
    .topbar h1 { font-size: 20px; margin: 0; }
    .topbar a.back { color: #7dd3fc; text-decoration: none; font-size: 13px; }
    .grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: 22px; align-items: start; }
    @media (max-width: 800px) { .grid { grid-template-columns: 1fr; } }
    .panel { background: #0f172a; border: 1px solid rgba(3,92,128,.18); border-radius: 16px; padding: 20px; }
    .panel h2 { font-size: 14px; margin: 0 0 14px; }
    .set-item { display:flex; align-items:center; justify-content:space-between; padding: 10px 12px; border-radius: 10px; border: 1px solid rgba(255,255,255,.06); margin-bottom: 8px; cursor: pointer; }
    .set-item:hover { border-color: rgba(3,92,128,.4); }
    .set-item .name { font-size: 13px; font-weight: 700; }
    .set-item .meta { font-size: 11px; color: #64748b; }
    .set-item button { background: none; border: none; color: #f87171; cursor: pointer; font-size: 13px; }
    .btn { padding: 9px 14px; border-radius: 9px; border: none; background: linear-gradient(135deg,#035c80,#024a6a); color: #fff; font-size: 12px; font-weight: 700; cursor: pointer; }
    .btn.ghost { background: transparent; border: 1px solid rgba(3,92,128,.35); color: #7dd3fc; }
    .btn.danger { background: transparent; border: 1px solid rgba(248,113,113,.35); color: #f87171; }
    .row { display: flex; gap: 8px; margin-bottom: 10px; flex-wrap: wrap; }
    .inp, textarea.inp { width: 100%; padding: 9px 11px; border-radius: 8px; border: 1px solid rgba(3,92,128,.25); background: #111c31; color: #f1f5f9; font-size: 13px; outline: none; }
    label.lab { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: #64748b; display: block; margin-bottom: 5px; }
    .q-card { border: 1px solid rgba(255,255,255,.08); border-radius: 12px; padding: 14px; margin-bottom: 12px; background: rgba(255,255,255,.02); }
    .q-card .opt-row { display: flex; gap: 6px; align-items: center; margin-bottom: 6px; }
    .opt-badge { width: 20px; height:20px; border-radius:5px; display:flex;align-items:center;justify-content:center; font-size:9px; font-weight:800; color:#fff; flex-shrink:0; cursor:pointer; }
    .toggle-row { display:flex; gap:14px; margin-top:8px; font-size:11px; color:#94a3b8; }
    .toggle-row label { display:flex; align-items:center; gap:5px; cursor:pointer; }
    .msg { font-size: 12px; margin-top: 10px; min-height: 16px; }
    .msg.ok { color: #86efac; } .msg.err { color: #fca5a5; }
    .file-drop { border: 1.5px dashed rgba(3,92,128,.35); border-radius: 12px; padding: 18px; text-align: center; font-size: 12px; color: #94a3b8; cursor: pointer; }
    .file-drop:hover { border-color: #035c80; }
    .empty { text-align: center; padding: 30px 10px; color: #64748b; font-size: 12px; }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="topbar">
      <h1>⚡ Mes quiz programmés</h1>
      <a class="back" href="javascript:window.close();window.history.back();">&larr; Retour</a>
    </div>

    <div class="grid">
      <!-- Liste des sets -->
      <div class="panel">
        <h2>Mes bancs de questions</h2>
        <div id="sets-list"><div class="empty">Chargement…</div></div>
        <button class="btn" style="width:100%;margin-top:10px;" onclick="QuizSets.newSet()">+ Nouveau quiz</button>

        <h2 style="margin-top:22px;">Importer un fichier</h2>
        <div class="file-drop" onclick="document.getElementById('file-input').click()">
          📄 Cliquer pour choisir un fichier <strong>.txt</strong> ou <strong>.qzx</strong> déjà rempli
        </div>
        <input type="file" id="file-input" accept=".txt,.qzx" style="display:none;" onchange="QuizSets.handleFileImport(event)">
        <div class="row" style="margin-top:12px;">
          <a class="btn ghost" style="text-decoration:none;flex:1;text-align:center;" href="/api/quiz-sets/template.txt">↓ Modèle .txt</a>
          <a class="btn ghost" style="text-decoration:none;flex:1;text-align:center;" href="/api/quiz-sets/template.qzx">↓ Modèle .qzx</a>
        </div>
        <p style="font-size:11px;color:#64748b;line-height:1.6;margin-top:10px;">
          Le <strong>.txt</strong> est simple (question/options/étoile pour la bonne réponse).
          Le <strong>.qzx</strong> est notre format enrichi : il supporte en plus le mode Bingo
          et le bonus de rapidité, question par question.
        </p>
      </div>

      <!-- Éditeur -->
      <div class="panel">
        <h2 id="editor-title">Sélectionnez ou créez un quiz</h2>
        <div id="editor-body"><div class="empty">Choisissez un quiz à gauche, ou créez-en un nouveau.</div></div>
      </div>
    </div>
  </div>

  <script src="/js/quiz-sets.js"></script>
</body>
</html>
