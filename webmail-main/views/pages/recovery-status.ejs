<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="icon" href="/favicon.ico" type="image/x-icon" />
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Sora', sans-serif; }
    body { background: #060d1a; color: #f1f5f9; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; }
    .card { width: 100%; max-width: 440px; background: #0f172a; border: 1px solid rgba(3,92,128,.18); border-radius: 18px; padding: 36px; text-align: center; }
    .icon { font-size: 40px; margin-bottom: 14px; }
    h1 { font-size: 19px; margin-bottom: 12px; }
    p { font-size: 14px; color: #94a3b8; line-height: 1.7; }
    a.btn { display:inline-block; margin-top: 24px; padding: 12px 22px; border-radius: 10px; background: linear-gradient(135deg,#035c80,#024a6a); color: #fff; text-decoration: none; font-size: 13px; font-weight: 700; }
  </style>
</head>
<body>
  <div class="card">
    <div class="icon"><%= success ? '✅' : '⚠️' %></div>
    <h1><%= success ? 'C\'est confirmé' : 'Oups' %></h1>
    <p><%= message %></p>
    <a class="btn" href="/login">Aller à la connexion</a>
  </div>
</body>
</html>
