<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= title %></title>
  <meta name="csrf-token" content="<%= csrfToken || '' %>">
  <link rel="stylesheet" href="/css/style.css"/>
  <link rel="stylesheet" href="/css/mail.css"/>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet"/>
  <style>
    body { background: var(--bg-base, var(--bg-main)); color: var(--text-1); font-family: 'Sora', sans-serif; margin: 0; }
    .cx-page { max-width: 920px; margin: 0 auto; padding: 28px 24px 80px; }
    .cx-back { display: inline-flex; align-items: center; gap: 8px; color: var(--text-muted);
      text-decoration: none; font-size: 13px; margin-bottom: 24px;
      padding: 6px 12px; border-radius: 8px; background: var(--bg-card);
      border: 1px solid var(--border); transition: color .15s; }
    .cx-back:hover { color: var(--accent); border-color: var(--accent); }
    .cx-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 20px; flex-wrap: wrap; }
    .cx-header h1 { font-size: 24px; font-weight: 800; margin: 0; }
    .cx-toolbar { display: flex; gap: 10px; margin-bottom: 20px; flex-wrap: wrap; }
    .cx-search { flex: 1; min-width: 200px; padding: 10px 14px; border-radius: 10px; border: 1px solid var(--border);
      background: var(--bg-card); color: var(--text-1); font-size: 13px; font-family: 'Sora', sans-serif; outline: none; }
    .cx-btn { padding: 10px 18px; border-radius: 10px; border: none; cursor: pointer; font-size: 13px; font-weight: 700;
      font-family: 'Sora', sans-serif; background: linear-gradient(135deg, var(--accent), #8b5cf6); color: #fff; }
    .cx-list { display: grid; gap: 10px; }
    .cx-card { display: flex; align-items: center; gap: 14px; padding: 14px 16px; border-radius: 12px;
      background: var(--bg-card); border: 1px solid var(--border); }
    .cx-avatar { width: 42px; height: 42px; border-radius: 50%; background: linear-gradient(135deg, var(--accent), #8b5cf6);
      display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 800; font-size: 15px; flex-shrink: 0; }
    .cx-info { flex: 1; min-width: 0; }
    .cx-name { font-size: 14px; font-weight: 700; color: var(--text-1); }
    .cx-sub { font-size: 12px; color: var(--text-muted); margin-top: 2px; }
    .cx-actions { display: flex; gap: 6px; flex-shrink: 0; }
    .cx-icon-btn { width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--border); background: transparent;
      color: var(--text-2); cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 14px; }
    .cx-icon-btn.fav.active { color: #f59e0b; border-color: rgba(245,158,11,.4); background: rgba(245,158,11,.1); }
    .cx-empty { text-align: center; padding: 60px 20px; color: var(--text-muted); }
    .cx-modal { position: fixed; inset: 0; z-index: 999; background: rgba(0,0,0,.7); display: none; align-items: center; justify-content: center; }
    .cx-modal.open { display: flex; }
    .cx-modal-card { background: var(--bg-panel); border: 1px solid var(--border); border-radius: 16px; width: 420px; max-width: 92vw; padding: 24px; }
    .cx-modal-card h3 { margin: 0 0 16px; font-size: 16px; }
    .cx-field { margin-bottom: 12px; }
    .cx-field label { display: block; font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 5px; }
    .cx-field input, .cx-field textarea { width: 100%; padding: 9px 11px; border-radius: 8px; border: 1px solid var(--border);
      background: var(--bg-card); color: var(--text-1); font-size: 13px; font-family: 'Sora', sans-serif; outline: none; box-sizing: border-box; }
    .cx-modal-actions { display: flex; gap: 10px; margin-top: 18px; }
    .cx-modal-actions button { flex: 1; padding: 10px; border-radius: 9px; font-size: 13px; font-weight: 700; cursor: pointer; font-family: 'Sora', sans-serif; }
    .cx-cancel { background: transparent; border: 1px solid var(--border); color: var(--text-2); }
    .cx-save { background: linear-gradient(135deg, var(--accent), #8b5cf6); border: none; color: #fff; }
  </style>
</head>
<body>
  <div class="cx-page">
    <a href="/mail" class="cx-back">← Retour au webmail</a>

    <div class="cx-header">
      <h1>👤 Contacts</h1>
    </div>

    <div class="cx-toolbar">
      <input type="text" id="cx-search" class="cx-search" placeholder="Rechercher un contact…" oninput="Contacts.onSearch(this.value)" />
      <button class="cx-btn" onclick="Contacts.openNew()">+ Nouveau contact</button>
    </div>

    <div id="cx-list" class="cx-list">
      <div class="cx-empty">Chargement…</div>
    </div>
  </div>

  <!-- Modal ajout/édition -->
  <div class="cx-modal" id="cx-modal">
    <div class="cx-modal-card">
      <h3 id="cx-modal-title">Nouveau contact</h3>
      <input type="hidden" id="cx-id" />
      <div class="cx-field"><label>Nom *</label><input type="text" id="cx-name" /></div>
      <div class="cx-field"><label>Email *</label><input type="email" id="cx-email" /></div>
      <div class="cx-field"><label>Téléphone</label><input type="text" id="cx-phone" /></div>
      <div class="cx-field"><label>Société</label><input type="text" id="cx-company" /></div>
      <div class="cx-field"><label>Notes</label><textarea id="cx-notes" rows="2"></textarea></div>
      <div id="cx-modal-err" style="font-size:12px;color:#f87171;min-height:16px;"></div>
      <div class="cx-modal-actions">
        <button class="cx-cancel" onclick="Contacts.closeModal()">Annuler</button>
        <button class="cx-save" onclick="Contacts.save()">Enregistrer</button>
      </div>
    </div>
  </div>

  <script src="/js/contacts.js"></script>
</body>
</html>
