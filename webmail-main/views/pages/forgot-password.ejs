<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <meta name="csrf-token" content="<%= csrfToken || '' %>">
  <link rel="icon" href="/favicon.ico" type="image/x-icon" />
  <link rel="stylesheet" href="/css/style.css" />
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Sora', sans-serif; }
    body { background: #060d1a; color: #f1f5f9; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; }
    .card { width: 100%; max-width: 420px; background: #0f172a; border: 1px solid rgba(3,92,128,.18); border-radius: 18px; padding: 34px; }
    .logo { display:flex; align-items:center; gap:10px; margin-bottom: 22px; }
    .logo img { width: 32px; height: 32px; border-radius: 8px; }
    .logo span { font-weight: 800; font-size: 15px; letter-spacing: .04em; }
    h1 { font-size: 20px; margin-bottom: 8px; }
    p.desc { font-size: 13px; color: #94a3b8; line-height: 1.6; margin-bottom: 24px; }
    label { font-size: 12px; font-weight: 700; color: #94a3b8; display: block; margin-bottom: 6px; text-transform: uppercase; letter-spacing: .04em; }
    .inp { width: 100%; padding: 12px 14px; border-radius: 10px; border: 1px solid rgba(3,92,128,.25); background: #111c31; color: #f1f5f9; font-size: 14px; outline: none; margin-bottom: 18px; }
    .inp:focus { border-color: #035c80; }
    button.submit { width: 100%; padding: 13px; border-radius: 10px; border: none; background: linear-gradient(135deg,#035c80,#024a6a); color: #fff; font-size: 14px; font-weight: 700; cursor: pointer; }
    button.submit:disabled { opacity: .6; cursor: default; }
    .msg { margin-top: 16px; font-size: 13px; line-height: 1.6; padding: 12px 14px; border-radius: 10px; display: none; }
    .msg.ok { display: block; background: rgba(34,197,94,.12); border: 1px solid rgba(34,197,94,.3); color: #86efac; }
    .msg.err { display: block; background: rgba(248,113,113,.1); border: 1px solid rgba(248,113,113,.3); color: #fca5a5; }
    .back { display:inline-block; margin-top: 20px; font-size: 13px; color: #7dd3fc; text-decoration: none; }
  </style>
</head>
<body>
  <div class="card">
    <div class="logo"><img src="/logo.png" alt="" onerror="this.style.display='none'"><span>TechSphere Webmail</span></div>
    <h1>Mot de passe oublié</h1>
    <p class="desc">
      Entrez votre adresse Netiify. Si une adresse de confiance a été confirmée pour ce compte,
      un lien de réinitialisation lui sera envoyé.
    </p>
    <form id="forgot-form">
      <label>Votre adresse email</label>
      <input type="email" id="forgot-email" class="inp" placeholder="prenom.nom@netiify.cloud" required autocomplete="username">
      <button type="submit" class="submit" id="forgot-btn">Envoyer le lien de réinitialisation</button>
    </form>
    <div id="forgot-msg" class="msg"></div>
    <a class="back" href="/login">&larr; Retour à la connexion</a>
  </div>

  <script>
    function getCsrfToken() {
      return document.querySelector('meta[name="csrf-token"]')?.content || '';
    }
    document.getElementById('forgot-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('forgot-btn');
      const msg = document.getElementById('forgot-msg');
      const email = document.getElementById('forgot-email').value.trim();
      btn.disabled = true;
      btn.textContent = 'Envoi…';
      msg.className = 'msg';
      try {
        const res = await fetch('/api/forgot-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': getCsrfToken() },
          body: JSON.stringify({ email })
        });
        const data = await res.json();
        msg.className = 'msg ' + (data.ok ? 'ok' : 'err');
        msg.textContent = data.message || data.error || 'Requête envoyée.';
      } catch (err) {
        msg.className = 'msg err';
        msg.textContent = 'Erreur réseau, réessayez.';
      } finally {
        btn.disabled = false;
        btn.textContent = 'Envoyer le lien de réinitialisation';
      }
    });
  </script>
</body>
</html>
