            <button class="wb-color-btn" style="background:#f1f5f9;border-color:#cbd5e1;" onclick="MeetApp.wbBgColor('#f1f5f9')"></button>
          </div>
          <div class="wb-inline-fields" style="margin-top:10px;">
            <div class="wb-inline-field">
              <label>Largeur</label>
              <input id="wb-w-input" type="number" min="10" max="2000" value="160" oninput="MeetApp.wbSetW(this.value)">
            </div>
            <div class="wb-inline-field">
              <label>Hauteur</label>
              <input id="wb-h-input" type="number" min="10" max="2000" value="80" oninput="MeetApp.wbSetH(this.value)">
            </div>
          </div>
        </section>
        <section class="wb-group">
          <div class="wb-group-title">Actions</div>
          <div class="wb-chip-row">
            <button class="wb-action-btn" onclick="MeetApp.wbUndo()">↩ Annuler</button>
            <button class="wb-action-btn" onclick="MeetApp.wbRedo()">↪ Rétablir</button>
            <button class="wb-action-btn" onclick="MeetApp.wbImportImage()">🖼 Importer</button>
            <button class="wb-action-btn" onclick="MeetApp.wbExport(document.getElementById('wb-export-format')?.value || 'png')">↓ Export</button>
            <button class="wb-action-btn" onclick="MeetApp.wbClear()" style="color:#f87171;border-color:rgba(248,113,113,.25);">🗑 Effacer</button>
          </div>
        </section>
      </div>
      <div class="wb-bottom-hint">Astuce : après insertion d’un élément, le mode passe automatiquement sur <strong>Sélection</strong>. Ctrl/Cmd + A sélectionne tout, Delete supprime la sélection, et un double-clic centre/zoome sur l’objet.</div>
    </aside>

    <section class="wb-center-stage">
      <div class="wb-topbar">
        <div class="wb-topbar-left">
          <button class="wb-icon-btn wb-mobile-toggle" onclick="MeetApp.toggleWbLeftRail()" title="Outils">☰</button>
          <div class="wb-title-stack">
            <div style="display:flex;align-items:center;gap:8px;"><button class="wb-icon-btn" onclick="location.href='/mail'" title="Retour à la messagerie">←</button><h3 style="margin:0;">Tableau blanc collaboratif</h3></div>
            <p>UX optimisée, composants UI, curseurs temps réel, export multi-format et propriétés avancées</p>
          </div>
        </div>
        <div class="wb-topbar-right" style="position:relative;">
          <select id="wb-export-format" class="wb-export-select" title="Choisir le format d'export">
            <option value="png">PNG</option>
            <option value="jpg">JPG</option>
            <option value="jpeg">JPEG</option>
            <option value="webp">WEBP</option>
            <option value="pdf">PDF</option>
          </select>
          <button class="wb-icon-btn" onclick="MeetApp.wbZoomOut()" title="Dézoomer">－</button><div id="wb-zoom-pct" class="wb-status-pill" data-mode="shared">100%</div><button class="wb-icon-btn" onclick="MeetApp.wbZoomIn()" title="Zoomer">＋</button><button class="wb-action-btn" onclick="MeetApp.wbExport(document.getElementById('wb-export-format')?.value || 'png')" title="Exporter le tableau">Exporter</button>
          <button class="wb-icon-btn" onclick="MeetApp.wbOpenSettings()" title="Paramètres du tableau">⚙</button>
          <div id="wb-lock-status" class="wb-status-pill" data-mode="shared">Partagé</div>
          <button id="wb-lock-btn" class="wb-action-btn" onclick="MeetApp.wbOpenAccessMenu()" title="Mode d'accès au tableau">Partage</button>
          <button class="wb-icon-btn wb-mobile-toggle" onclick="MeetApp.toggleWbRightRail()" title="Propriétés">☷</button>
          <button type="button" class="wb-action-btn wbai-open-btn" onclick="WbAI.open()" title="Demander à l'IA de dessiner">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3z"/></svg>
            IA
          </button>
          <button class="wb-icon-btn" onclick="MeetApp.toggleWhiteboard()" title="Fermer le tableau">✕</button>
        </div>
      </div>
      <div class="wb-canvas-stage">
        <div class="wb-canvas-frame">
          <div id="wb-canvas-scroll">
            <div id="wb-canvas-inner">
              <canvas id="wb-canvas"></canvas>
              <div id="wb-cursor-layer"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <aside class="wb-right-rail" id="wb-right-rail">
      <div class="wb-rail-tabs" role="tablist">
        <button type="button" class="wb-rail-tab active" data-tab="props" role="tab" onclick="WbAI.showTab('props')">Propriétés</button>
        <button type="button" class="wb-rail-tab" data-tab="ai" role="tab" onclick="WbAI.showTab('ai')">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3z"/><path d="M19 15l.9 2.1L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9L19 15z"/></svg>
          Assistant IA
        </button>
      </div>

      <div id="wb-tab-props" class="wb-tab-body">
        <div class="wb-panel-head">
          <div>
            <div class="wb-panel-title">Propriétés</div>
            <div class="wb-panel-sub">Sélectionnez un élément pour l’éditer finement</div>
          </div>
          <button class="wb-icon-btn wb-mobile-toggle" onclick="MeetApp.toggleWbRightRail()" title="Fermer le panneau propriétés">✕</button>
        </div>
        <div id="wb-props-panel"><div class="wb-props-empty">Aucun élément sélectionné pour le moment. Cliquez sur un objet ou déposez-en un sur le tableau pour voir ses réglages.</div></div>
      </div>

      <div id="wb-tab-ai" class="wb-tab-body wbai" hidden>
        <div class="wb-panel-head">
          <div>
            <div class="wb-panel-title">Assistant dessin</div>
            <div class="wb-panel-sub">Décrivez, l’IA dessine pour tous les participants</div>
          </div>
          <button type="button" class="wb-icon-btn" onclick="WbAI.clearConversation()" title="Effacer la conversation (le tableau n'est pas modifié)" aria-label="Effacer la conversation" style="width:30px;height:30px;font-size:11px;">⟲</button>
          <button class="wb-icon-btn wb-mobile-toggle" onclick="MeetApp.toggleWbRightRail()" title="Fermer le panneau">✕</button>
        </div>
        <div class="wbai-msgs" id="wbai-msgs">
          <div class="wbai-welcome" id="wbai-welcome">
            <div class="wbai-welcome-title">Que voulez-vous dessiner&nbsp;?</div>
            <div class="wbai-welcome-text">Schémas, organigrammes, flux, cartes mentales, plannings… Le dessin apparaît chez tout le monde et reste modifiable.</div>
            <div class="wbai-chips">
              <button type="button" onclick="WbAI.suggest('Un organigramme simple d\'une équipe projet avec un chef de projet et trois équipes')">Organigramme</button>
              <button type="button" onclick="WbAI.suggest('Un schéma de processus en 5 étapes avec des flèches')">Processus en étapes</button>
              <button type="button" onclick="WbAI.suggest('Une carte mentale avec une idée centrale et 5 branches')">Carte mentale</button>
              <button type="button" onclick="WbAI.suggest('Un planning de la semaine du lundi au vendredi en colonnes')">Planning semaine</button>
            </div>
          </div>
        </div>
        <div class="wbai-composer">
          <textarea id="wbai-input" rows="2" maxlength="600" placeholder="Ex : un schéma de l’architecture du projet" onkeydown="WbAI.onKey(event)"></textarea>
          <button type="button" id="wbai-send" onclick="WbAI.send()" title="Envoyer à l’IA" aria-label="Envoyer à l’IA">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          </button>
        </div>
      </div>
    </aside>
  </div>
</div>

<!-- ── Modale avis réunion ── -->
<div id="review-modal">
  <div class="review-card">
    <div style="text-align:center;margin-bottom:8px;">
      <div style="font-size:32px;margin-bottom:12px;display:flex;justify-content:center;"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg></div>
      <div style="font-size:18px;font-weight:800;color:var(--text1);margin-bottom:6px;">La réunion est terminée</div>
      <div style="font-size:13px;color:var(--muted);line-height:1.6;">Comment s'est passée cette réunion ?<br>Votre avis nous aide à améliorer le service.</div>
    </div>

    <div class="review-stars" id="review-stars">
      <button class="star-btn" data-v="1" onclick="MeetApp.setRating(1)"><svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></button>
      <button class="star-btn" data-v="2" onclick="MeetApp.setRating(2)"><svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></button>
      <button class="star-btn" data-v="3" onclick="MeetApp.setRating(3)"><svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></button>
      <button class="star-btn" data-v="4" onclick="MeetApp.setRating(4)"><svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></button>
      <button class="star-btn" data-v="5" onclick="MeetApp.setRating(5)"><svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></button>
    </div>
    <div id="rating-label" style="text-align:center;font-size:13px;color:var(--muted);margin-bottom:16px;min-height:20px;"></div>

    <textarea class="review-comment" id="review-comment" rows="3"
      placeholder="Comment pourrions-nous améliorer le service ? (optionnel)"></textarea>

    <div style="display:flex;gap:10px;">
      <button onclick="MeetApp.skipReview()"
        style="flex:1;padding:11px;border-radius:10px;border:1px solid var(--border);background:transparent;color:var(--text2);font-size:13px;font-weight:600;cursor:pointer;font-family:'Sora',sans-serif;">
        Passer
      </button>
      <button id="review-submit-btn" onclick="MeetApp.submitReview()" disabled
        style="flex:1;padding:11px;border-radius:10px;border:none;background:linear-gradient(135deg,var(--accent),#024a6a);color:white;font-size:13px;font-weight:700;cursor:pointer;font-family:'Sora',sans-serif;opacity:.5;transition:opacity .2s;">
        Envoyer mon avis
      </button>
    </div>
  </div>
</div>

<script src="/socket.io/socket.io.js"></script>
