<script>
window.MEET_CONFIG = {
  MEETING_ID:      '<%= meeting.id %>',
  MEETING_CODE:    '<%= meeting.code || "" %>',
  PARENT_MEETING_ID: '<%= meeting.parent_meeting_id || "" %>',
  BREAKOUT_LABEL:  '<%= meeting.breakout_label || "" %>',
  USER_EMAIL:      '<%= userEmail || "" %>',
  IS_HOST:         '<%= (meeting.host||"").trim().toLowerCase() %>' === '<%= (userEmail||"").trim().toLowerCase() %>',
  NEEDS_CODE:      <%= locals.needsCode ? 'true' : 'false' %>,
  IS_GUEST:        <%= locals.isGuest   ? 'true' : 'false' %>,
  REVIEWS_ENABLED: <%= process.env.ENABLE_REVIEWS === 'true' ? 'true' : 'false' %>,
};
