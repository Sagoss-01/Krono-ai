<script>
(function bootstrapMeetingApp() {
  const g = window;

  if (typeof g.toggleScreen !== 'function' && typeof g.toggleScreenShare === 'function') {
    g.toggleScreen = g.toggleScreenShare;
  }
  if (typeof g.toggleScreenShare !== 'function' && typeof g.toggleScreen === 'function') {
    g.toggleScreenShare = g.toggleScreen;
  }

  if (typeof g.openWhiteboard !== 'function' && typeof g.toggleWhiteboard === 'function') {
    g.openWhiteboard = g.toggleWhiteboard;
  }
  if (typeof g.clearWhiteboard !== 'function' && typeof g.wbClear === 'function') {
    g.clearWhiteboard = g.wbClear;
  }
  if (typeof g.setWbTool !== 'function' && typeof g.wbTool === 'function') {
    g.setWbTool = g.wbTool;
  }
  if (typeof g.setWbColor !== 'function' && typeof g.wbColor === 'function') {
    g.setWbColor = g.wbColor;
  }
  if (typeof g.setWbSize !== 'function' && typeof g.wbSize === 'function') {
    g.setWbSize = g.wbSize;
  }

  const fallback = (name) => function(...args) {
    console.warn(`[MeetApp] Fonction indisponible: ${name}`);
    if (typeof g.notify === 'function') g.notify(`Fonction indisponible: ${name}`);
    return undefined;
  };
  const pick = (...names) => {
    for (const name of names) {
      if (typeof g[name] === 'function') return g[name];
    }
    return fallback(names[0]);
  };

  g.MeetApp = {
    toggleLobbyMic: pick('toggleLobbyMic'),
    toggleLobbyCam: pick('toggleLobbyCam'),
    joinRoom: pick('joinRoom'),
    admitWaiting: pick('admitWaiting'),
    rejectWaiting: pick('rejectWaiting'),

    toggleMic: pick('toggleMic'),
    toggleCam: pick('toggleCam'),
    toggleHand: pick('toggleHand'),
    toggleScreen: pick('toggleScreenShare', 'toggleScreen'),
    toggleBackgroundBlur: pick('toggleBackgroundBlur'),
    toggleRecord: pick('toggleRecord'),
    toggleMini: pick('toggleMini'),
    toggleWhiteboard: pick('toggleWhiteboard'),
    openWhiteboard: pick('openWhiteboard', 'toggleWhiteboard'),
    togglePin: pick('togglePin'),
    toggleCaptions: pick('toggleCaptions'),

    toggleChat: pick('toggleChat'),
    switchTab: pick('switchTab'),
    toggleReactions: pick('toggleReactions'),
    toggleTheme: pick('toggleTheme'),
    openParticipationPanel: pick('openParticipationPanel'),
    closeParticipationPanel: pick('closeParticipationPanel'),
    toggleParticipationPanel: pick('toggleParticipationPanel'),
    switchParticipationTab: pick('switchParticipationTab'),
    toggleBitrateReduction: pick('toggleBitrateReduction'),
    openAdminPanel: pick('openAdminPanel'),
    closeAdminPanel: pick('closeAdminPanel'),
    toggleAdminPanel: pick('toggleAdminPanel'),
    switchAdminTab: pick('switchAdminTab'),

    sendReaction: pick('sendReaction'),
    showInfo: pick('showInfo'),
    copy: pick('copy'),
    copyMeetingLink: pick('copyMeetingLink'),

    sendChat: pick('sendChat'),
    sendFile: pick('sendFile'),
    meetingChatHandleDownload: pick('meetingChatHandleDownload'),

    leave: pick('leave'),
    confirmLeave: pick('confirmLeave'),

    setRating: pick('setRating'),
    submitReview: pick('submitReview'),
    skipReview: pick('skipReview'),

    hostMutePeer: pick('hostMutePeer'),
    toggleCatalyst: pick('toggleCatalyst'),
    extendMeeting: pick('extendMeeting'),
    moveParticipantToWaiting: pick('moveParticipantToWaiting'),
    removeParticipant: pick('removeParticipant'),
    banParticipant: pick('banParticipant'),
    lockMeeting: pick('lockMeeting'),
    muteAllParticipants: pick('muteAllParticipants'),
    updateParticipantPermissions: pick('updateParticipantPermissions'),
    toggleParticipantPermission: pick('toggleParticipantPermission'),
    allowParticipantToSpeak: pick('allowParticipantToSpeak'),
    tempExpelParticipant: pick('tempExpelParticipant'),

    exportNotes: pick('exportNotes'),

    addPollOption: pick('addPollOption'),
    launchPoll: pick('launchPoll'),
    castVote: pick('castVote'),
    newPoll: pick('newPoll'),
    endPoll: pick('endPoll'),

    wbTool: pick('wbTool'),
    wbColor: pick('wbColor'),
    wbBgColor: pick('wbBgColor'),
    wbSize: pick('wbSize'),
    wbClear: pick('wbClear'),
    wbExport: pick('wbExport'),
    wbImportImage: pick('wbImportImage'),
    wbUndo: pick('wbUndo'),
    wbRedo: pick('wbRedo'),
    wbSetW: pick('wbSetW'),
    wbSetH: pick('wbSetH'),
    wbSetSelectedDimensions: pick('wbSetSelectedDimensions'),
    wbUpdateProp: pick('wbUpdateProp'),
    wbDeleteObj: pick('wbDeleteObj'),
    wbDuplicateObj: pick('wbDuplicateObj'),
    wbBringFront: pick('wbBringFront'),
    wbSendBack: pick('wbSendBack'),
    hideWbProperties: pick('hideWbProperties'),
    setWbTool: pick('setWbTool', 'wbTool'),
    setWbColor: pick('setWbColor', 'wbColor'),
    setWbSize: pick('setWbSize', 'wbSize'),
    clearWhiteboard: pick('clearWhiteboard', 'wbClear'),
    wbToggleLock: pick('wbToggleLock'),
    wbOpenAccessMenu: pick('wbOpenAccessMenu'),
    wbSetAccessMode: pick('wbSetAccessMode'),
    wbOpenSettings: pick('wbOpenSettings'),
    wbZoomIn: pick('wbZoomIn'),
    wbZoomOut: pick('wbZoomOut'),
    wbZoomReset: pick('wbZoomReset'),
    wbCenterSelection: pick('wbCenterSelection'),
    wbInsertTemplate: pick('wbInsertTemplate'),
    wbSetCursorScale: pick('wbSetCursorScale'),
    wbApplyBoardTheme: pick('wbApplyBoardTheme'),
    wbApplyToolSearch: pick('wbApplyToolSearch'),
    toggleWbLeftRail: pick('toggleWbLeftRail'),
    toggleWbRightRail: pick('toggleWbRightRail'),

    openPopcornLauncher: pick('openPopcornLauncher'),
    openBreakoutPanel: pick('openBreakoutPanel'),
    launchPopcorn: pick('launchPopcorn'),
    submitPopcornAnswer: pick('submitPopcornAnswer'),

    openQuizCreator: pick('openQuizCreator'),
    launchQuiz: pick('launchQuiz'),
    submitQuizVote: pick('submitQuizVote'),

    setSpeechLimit: pick('setSpeechLimit'),
    openSpeakLimit: pick('openSpeakLimit'),

    sendAIMessage: pick('sendAIMessage'),
    clearAIChat: pick('clearAIChat'),
    generateSummary: pick('generateSummary')
  };

  const theme = localStorage.getItem('ts_theme') || 'dark';
  if (typeof g.applyMeetTheme === 'function') g.applyMeetTheme(theme);
  if (typeof g.initLobby === 'function') g.initLobby();

  document.getElementById('lctrl-mic-btn')?.addEventListener('click', g.MeetApp.toggleLobbyMic);
  document.getElementById('lctrl-cam-btn')?.addEventListener('click', g.MeetApp.toggleLobbyCam);
  document.getElementById('btn-join')?.addEventListener('click', g.MeetApp.joinRoom);
  document.getElementById('lobby-copy-btn')?.addEventListener('click', g.MeetApp.copyMeetingLink);
})();
</script>
</body>
</html>