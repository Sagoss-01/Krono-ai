<!DOCTYPE html>
<html lang="fr" data-theme="dark">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= title %>
  </title>
  <meta name="description" content="TechSphere Webmail — Messagerie professionnelle sécurisée" />
  <meta property="og:title" content="TechSphere Webmail" />
  <meta property="og:description" content="Messagerie professionnelle sécurisée — netiify.cloud" />
  <meta property="og:image" content="/logo.png" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="/logo.png" />
  <link rel="icon" href="/favicon.ico" type="image/x-icon" />
  <link rel="apple-touch-icon" href="/logo.png" />
  <meta name="theme-color" content="#035c80" />
  <link rel="stylesheet" href="/css/style.css" />
  <link
    href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet" />
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Sora', sans-serif;
    }

    body {
      background: #060d1a;
      color: #f1f5f9;
      min-height: 100vh;
      display: flex;
      overflow: hidden;
    }

    .left-panel {
      width: 55%;
      background: linear-gradient(145deg, #0b1628 0%, #060d1a 60%);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 40px 48px;
      position: relative;
      overflow: hidden;
    }

    .left-panel::before {
      content: '';
      position: absolute;
      top: -200px;
      left: -200px;
      width: 600px;
      height: 600px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(3, 92, 128, 0.15), transparent 70%);
      pointer-events: none;
    }

    .left-panel::after {
      content: '';
      position: absolute;
      bottom: -150px;
      right: -100px;
      width: 400px;
      height: 400px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(139, 92, 246, 0.08), transparent 70%);
      pointer-events: none;
    }

    .grid-overlay {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(3, 92, 128, 0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(3, 92, 128, 0.05) 1px, transparent 1px);
      background-size: 50px 50px;
    }

    .left-logo {
      display: flex;
      align-items: center;
      gap: 12px;
      position: relative;
      z-index: 2;
    }

    .left-logo-icon {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      background: linear-gradient(135deg, #035c80, #8b5cf6);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 20px rgba(3, 92, 128, 0.35);
    }

    .left-logo-name {
      font-weight: 800;
      font-size: 18px;
    }

    .left-logo-sub {
      font-size: 10px;
      color: #475569;
      letter-spacing: .1em;
      text-transform: uppercase;
    }

    .left-main {
      position: relative;
      z-index: 2;
    }

    .left-main h2 {
      font-size: clamp(28px, 3vw, 42px);
      font-weight: 800;
      line-height: 1.15;
      letter-spacing: -.02em;
      margin-bottom: 16px;
      background: linear-gradient(135deg, #f1f5f9, #64748b);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .left-main h2 span {
      background: linear-gradient(135deg, #035c80, #8b5cf6);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .left-main p {
      font-size: 14px;
      color: #475569;
      line-height: 1.7;
      max-width: 380px;
    }

    .left-features {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .feat-row {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      border-radius: 12px;
      background: rgba(15, 23, 42, 0.5);
      border: 1px solid rgba(3, 92, 128, 0.10);
    }

    .feat-icon {
      width: 34px;
      height: 34px;
      border-radius: 9px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .feat-text {
      font-size: 13px;
      color: #94a3b8;
      line-height: 1.4;
    }

    .feat-text strong {
      color: #cbd5e1;
      display: block;
      font-size: 12px;
      margin-bottom: 2px;
    }

    /* RIGHT PANEL */
    .right-panel {
      width: 45%;
      background: #0f172a;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 48px 40px;
      border-left: 1px solid rgba(3, 92, 128, 0.12);
      overflow-y: auto;
    }

    .form-wrap {
      width: 100%;
      max-width: 360px;
    }

    .form-title {
      font-size: 26px;
      font-weight: 800;
      color: #f1f5f9;
      margin-bottom: 6px;
    }

    .form-sub {
      font-size: 13px;
      color: #475569;
      margin-bottom: 28px;
    }

    .alert-error {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 14px;
      border-radius: 10px;
      margin-bottom: 20px;
      background: rgba(239, 68, 68, 0.1);
      border: 1px solid rgba(239, 68, 68, 0.2);
      font-size: 13px;
      color: #f87171;
    }

    /* Comptes mémorisés */
    .known-accounts {
      margin-bottom: 22px;
    }

    .known-title {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: #475569;
      margin-bottom: 10px;
    }

    .known-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
      max-height: 210px;
      overflow-y: auto;
      padding-right: 2px;
      scrollbar-width: thin;
      scrollbar-color: rgba(3, 92, 128, 0.25) transparent;
    }

    .known-list::-webkit-scrollbar {
      width: 4px;
    }

    .known-list::-webkit-scrollbar-track {
      background: transparent;
    }

    .known-list::-webkit-scrollbar-thumb {
      background: rgba(3, 92, 128, 0.25);
      border-radius: 4px;
    }

    .known-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 9px 12px;
      border-radius: 10px;
      cursor: pointer;
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid rgba(3, 92, 128, 0.12);
      transition: all .15s;
      flex-shrink: 0;
    }

    .known-item:hover {
      border-color: rgba(3, 92, 128, 0.35);
      background: rgba(3, 92, 128, 0.08);
    }

    .known-avatar {
      width: 28px;
      height: 28px;
      border-radius: 8px;
      background: linear-gradient(135deg, #035c80, #8b5cf6);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      font-weight: 800;
      color: white;
      flex-shrink: 0;
    }

    .known-email {
      font-size: 13px;
      color: #cbd5e1;
      flex: 1;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .known-arrow {
      color: #475569;
      flex-shrink: 0;
    }

    .known-delete {
      flex-shrink: 0;
      background: none;
      border: none;
      cursor: pointer;
      color: #334155;
      padding: 4px;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all .15s;
    }

    .known-delete:hover {
      color: #f87171;
      background: rgba(239, 68, 68, 0.1);
    }

    .divider {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 18px 0;
      color: #334155;
      font-size: 11px;
    }

    .divider::before,
    .divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: rgba(3, 92, 128, 0.12);
    }

    .field {
      margin-bottom: 18px;
    }

    .field label {
      display: block;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: #475569;
      margin-bottom: 7px;
    }

    .email-split {
      display: flex;
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid rgba(3, 92, 128, 0.25);
      transition: border-color .2s;
      background: rgba(15, 23, 42, 0.8);
    }

    .email-split:focus-within {
      border-color: rgba(3, 92, 128, 0.55);
      box-shadow: 0 0 0 3px rgba(3, 92, 128, 0.10);
    }

    .email-split input {
      flex: 1;
      background: transparent;
      border: none;
      outline: none;
      padding: 11px 14px;
      font-size: 14px;
      color: #f1f5f9;
      font-family: 'Sora', sans-serif;
    }

    .email-split input::placeholder {
      color: #334155;
    }

    .email-domain {
      padding: 11px 14px;
      font-size: 13px;
      font-weight: 600;
      color: #035c80;
      background: rgba(3, 92, 128, 0.08);
      border-left: 1px solid rgba(3, 92, 128, 0.18);
      white-space: nowrap;
      user-select: none;
      font-family: 'JetBrains Mono', monospace;
    }

    .inp {
      width: 100%;
      padding: 11px 14px;
      border-radius: 10px;
      font-size: 14px;
      background: rgba(15, 23, 42, 0.8);
      border: 1px solid rgba(3, 92, 128, 0.25);
      color: #f1f5f9;
      outline: none;
      transition: all .2s;
      font-family: 'Sora', sans-serif;
    }

    .inp:focus {
      border-color: rgba(3, 92, 128, 0.55);
      box-shadow: 0 0 0 3px rgba(3, 92, 128, 0.10);
    }

    .inp::placeholder {
      color: #334155;
    }

    .pwd-wrap {
      position: relative;
    }

    .pwd-eye {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      cursor: pointer;
      color: #475569;
      display: flex;
      align-items: center;
      padding: 4px;
    }

    .pwd-eye:hover {
      color: #94a3b8;
    }

    .btn-submit {
      width: 100%;
      padding: 13px;
      border-radius: 11px;
      border: none;
      cursor: pointer;
      font-size: 15px;
      font-weight: 700;
      color: white;
      background: linear-gradient(135deg, #035c80, #024a6a);
      box-shadow: 0 6px 24px rgba(3, 92, 128, 0.35);
      transition: all .2s;
      margin-top: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .btn-submit:hover:not(:disabled) {
      transform: translateY(-1px);
      box-shadow: 0 8px 32px rgba(3, 92, 128, 0.45);
    }

    .btn-submit:disabled {
      opacity: .7;
      cursor: not-allowed;
    }

    /* Modal mot de passe rapide */
    .quick-pwd-modal {
      position: fixed;
      inset: 0;
      z-index: 9999;
      background: rgba(0, 0, 0, 0.7);
      display: none;
      align-items: center;
      justify-content: center;
    }

    .quick-pwd-modal.open {
      display: flex;
    }

    .quick-pwd-card {
      background: #0f172a;
      border: 1px solid rgba(3, 92, 128, 0.25);
      border-radius: 14px;
      padding: 24px;
      width: 320px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
      animation: slideUp .2s ease;
    }

    @keyframes slideUp {
      from {
        opacity: 0;
        transform: translateY(12px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .quick-pwd-card h3 {
      font-size: 16px;
      font-weight: 700;
      margin-bottom: 6px;
      color: #f1f5f9;
    }

    .quick-pwd-card p {
      font-size: 12px;
      color: #475569;
      margin-bottom: 16px;
    }

    .quick-err {
      font-size: 12px;
      color: #f87171;
      margin-top: 8px;
      display: none;
    }

    .form-footer {
      margin-top: 24px;
      text-align: center;
      font-size: 12px;
      color: #334155;
    }

    .form-footer a {
      color: #035c80;
      text-decoration: none;
    }

    .server-info {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: 28px;
      justify-content: center;
    }

    .server-tag {
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 10px;
      font-weight: 600;
      font-family: 'JetBrains Mono', monospace;
      letter-spacing: .04em;
      background: rgba(3, 92, 128, 0.10);
      border: 1px solid rgba(3, 92, 128, 0.18);
      color: #4db8d8;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    .spin {
      animation: spin .7s linear infinite;
      display: inline-block;
    }

    @media (max-width: 768px) {
      body {
        flex-direction: column;
        overflow: auto;
      }

      .left-panel {
        width: 100%;
        padding: 32px 24px 40px;
      }

      .left-features {
        display: none;
      }

      .right-panel {
        width: 100%;
        border-left: none;
        border-top: 1px solid rgba(3, 92, 128, 0.12);
        padding: 40px 24px;
        overflow-y: visible;
      }
    }

    .email-domain {
      padding: 11px 14px;
      font-size: 13px;
      font-weight: 600;
      color: #035c80;
      background: rgba(3, 92, 128, 0.08);
      border: none;
      /* On enlève les bordures par défaut du select */
      border-left: 1px solid rgba(3, 92, 128, 0.18);
      white-space: nowrap;
      user-select: none;
      font-family: 'JetBrains Mono', monospace;

      /* Améliorations pour le select */
      cursor: pointer;
      outline: none;
      appearance: none;
      /* Supprime la flèche par défaut pour un look plus clean */
      -webkit-appearance: none;
      -moz-appearance: none;
    }

    /* Optionnel : pour que le survol soit plus interactif */
    .email-domain:hover {
      background: rgba(3, 92, 128, 0.12);
    }

    /* Style des options à l'intérieur du menu */
    .email-domain option {
      background: #fff;
      /* Pour assurer la lisibilité du texte */
      color: #333;
      font-family: sans-serif;
      /* Les polices Mono sont parfois capricieuses dans les dropdowns */
    }
  </style>
</head>

<body>

  <!-- LEFT PANEL -->
  <div class="left-panel">
    <div class="grid-overlay"></div>
    <a href="/" class="left-logo" style="text-decoration:none;">
      <div class="left-logo-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="white">
          <path
            d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z" />
        </svg>
      </div>
      <div>
        <div class="left-logo-name">TechSphere</div>
        <div class="left-logo-sub">Webmail</div>
      </div>
    </a>
    <div class="left-main">
      <h2>Accédez à<br />votre espace<br /><span>mail sécurisé</span></h2>
      <p>Gérez vos emails professionnels depuis n'importe où avec une interface moderne, rapide et sécurisée.</p>
    </div>
    <div class="left-features">
      <div class="feat-row">
        <div class="feat-icon" style="background:rgba(3,92,128,0.12);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#035c80" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
          </svg>
        </div>
        <div class="feat-text"><strong>Chiffrement SSL/TLS</strong>Connexion IMAP sécurisée</div>
      </div>
      <div class="feat-row">
        <div class="feat-icon" style="background:rgba(34,197,94,0.1);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2">
            <circle cx="12" cy="12" r="10" />
            <polyline points="12 6 12 12 16 14" />
          </svg>
        </div>
        <div class="feat-text"><strong>Temps réel</strong>Réception instantanée</div>
      </div>
      <div class="feat-row">
        <div class="feat-icon" style="background:rgba(139,92,246,0.1);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
            <circle cx="9" cy="7" r="4" />
            <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
          </svg>
        </div>
        <div class="feat-text"><strong>Multi-comptes</strong>Accès à plusieurs boites mails simultanément</div>
      </div>
    </div>
  </div>

  <!-- RIGHT PANEL -->
  <div class="right-panel">
    <div class="form-wrap">
      <div class="form-title">Connexion</div>
      <div class="form-sub">Entrez vos identifiants</div>

      <% if (error) { %>
        <div class="alert-error">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="8" x2="12" y2="12" />
            <line x1="12" y1="16" x2="12.01" y2="16" />
          </svg>
          <%= error %>
        </div>
        <% } %>

          <!-- Comptes mémorisés -->
          <% if (knownAccounts && knownAccounts.length> 0) { %>
            <div class="known-accounts">
              <div class="known-title">Comptes récents</div>
              <div class="known-list">
                <% knownAccounts.forEach(function(ka) { %>
                  <div class="known-item" id="known-<%= ka.replace(/[@.+]/g,'-') %>" onclick="selectKnown('<%= ka %>')">
                    <div class="known-avatar">
                      <%= ka[0].toUpperCase() %>
                    </div>
                    <span class="known-email">
                      <%= ka %>
                    </span>
                    <svg class="known-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none"
                      stroke="currentColor" stroke-width="2">
                      <polyline points="9 18 15 12 9 6" />
                    </svg>
                    <button class="known-delete" title="Supprimer ce compte récent"
                      onclick="deleteKnown(event, '<%= ka %>')" aria-label="Supprimer">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2.2">
                        <polyline points="3 6 5 6 21 6" />
                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                        <path d="M10 11v6M14 11v6" />
                        <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
                      </svg>
                    </button>
                  </div>
                  <% }); %>
              </div>
              <div class="divider">ou nouveau compte</div>
            </div>
            <% } %>

              <% if (locals.require2FA) { %>
              <form method="POST" action="/login/2fa" id="twofa-form">
                <div style="text-align:center;margin-bottom:18px;">
                  <div style="font-size:32px;margin-bottom:8px;">🔐</div>
                  <div style="font-size:14px;font-weight:700;color:#e2e8f0;">Vérification en deux étapes</div>
                  <div style="font-size:12px;color:#94a3b8;margin-top:4px;">Entre le code de ton application d'authentification pour <b><%= pendingEmail %></b></div>
                </div>
                <div class="field">
                  <label>Code de vérification</label>
                  <input type="text" name="token" id="twofa-token" placeholder="123456 ou XXXXX-XXXXX" autocomplete="one-time-code"
                    autofocus class="inp" style="text-align:center;font-size:18px;letter-spacing:.15em;" maxlength="11" />
                </div>
                <button type="submit" class="btn-submit" style="margin-top:14px;">Vérifier</button>
                <div style="text-align:center;margin-top:14px;">
                  <a href="/login" style="font-size:12px;color:#64748b;text-decoration:none;">← Annuler et revenir à la connexion</a>
                </div>
              </form>
              <% } else { %>
              <form method="POST" action="/login" id="login-form">
                <input type="hidden" name="redirect" value="<%= locals.redirectTo || '' %>" />
                <div class="field">
                  <label>Adresse email</label>
                  <div class="email-split">
                    <input type="text" name="username" id="username" placeholder="votre.nom" autocomplete="username"
                      required />
                    <select name="domain" id="domain-select" class="email-domain">
                      <option value="@netiify.cloud">@netiify.cloud</option>
                      <option value="@kweapp.com">@kweapp.com</option>
                    </select>
                  </div>
                </div>
                <div class="field">
                  <label>Mot de passe</label>
                  <div class="pwd-wrap">
                    <input type="password" name="password" id="password" class="inp" placeholder="••••••••"
                      autocomplete="current-password" required />
                    <button type="button" class="pwd-eye" onclick="togglePwd()" id="eye-btn">
                      <svg id="eye-open" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                        <circle cx="12" cy="12" r="3" />
                      </svg>
                      <svg id="eye-close" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2" style="display:none;">
                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                        <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                        <line x1="1" y1="1" x2="23" y2="23" />
                      </svg>
                    </button>
                  </div>
                </div>
                <div class="remember-me-row">
                  <label class="remember-label">
                    <input type="checkbox" name="rememberMe" value="1" id="rememberMe" />
                    <span class="remember-check"></span>
                    <span class="remember-text">Rester connecté pendant 90 jours</span>
                  </label>
                  <a href="javascript:void(0)" onclick="openForgotPassword()" style="font-size:12px;color:var(--accent,#7dd3fc);text-decoration:none;">Mot de passe oublié ?</a>
                </div>
                <button type="submit" class="btn-submit" id="submit-btn">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                    <polyline points="10 17 15 12 10 7" />
                    <line x1="15" y1="12" x2="3" y2="12" />
                  </svg>
                  Se connecter
                </button>
              </form>
              <% } %>

              <div class="server-info">
                <span class="server-tag">IMAP 993 SSL</span>
                <span class="server-tag">SMTP 587 TLS</span>
                <span class="server-tag">mail.netiify.cloud</span>
              </div>
              <div class="form-footer">
                <a href="/">← Retour à l'accueil</a> ·
                <a href="/register">Créer un compte</a>
              </div>
    </div>
  </div>

  <!-- Modal mot de passe oublié -->
  <div class="quick-pwd-modal" id="forgot-modal">
    <div class="quick-pwd-card">
      <div id="forgot-step-email">
        <h3>Mot de passe oublié</h3>
        <p>Entrez votre adresse email — un code sera envoyé à votre email de secours (si vous en avez confirmé un).</p>
        <input type="text" id="forgot-email" class="inp" placeholder="votre.nom@netiify.cloud" style="margin-top:10px;" />
        <div class="quick-err" id="forgot-email-err"></div>
        <button class="btn-submit" id="forgot-email-submit" onclick="submitForgotEmail()" style="margin-top:14px;">
          Envoyer le code
        </button>
        <button onclick="closeForgotPassword()"
          style="width:100%;margin-top:8px;padding:10px;background:none;border:none;color:#475569;cursor:pointer;font-size:13px;">
          Annuler
        </button>
      </div>
      <div id="forgot-step-reset" style="display:none;">
        <h3>Nouveau mot de passe</h3>
        <p>Entrez le code reçu par email et votre nouveau mot de passe.</p>
        <input type="text" id="forgot-code" class="inp" placeholder="Code à 6 chiffres" maxlength="6" inputmode="numeric" style="margin-top:10px;" />
        <div class="pwd-wrap" style="margin-top:10px;">
          <input type="password" id="forgot-newpwd" class="inp" placeholder="Nouveau mot de passe" autocomplete="new-password" />
        </div>
        <div class="pwd-wrap" style="margin-top:10px;">
          <input type="password" id="forgot-newpwd2" class="inp" placeholder="Confirmer le mot de passe" autocomplete="new-password" />
        </div>
        <div class="quick-err" id="forgot-reset-err"></div>
        <button class="btn-submit" id="forgot-reset-submit" onclick="submitForgotReset()" style="margin-top:14px;">
          Réinitialiser le mot de passe
        </button>
        <button onclick="closeForgotPassword()"
          style="width:100%;margin-top:8px;padding:10px;background:none;border:none;color:#475569;cursor:pointer;font-size:13px;">
          Annuler
        </button>
      </div>
    </div>
  </div>

  <!-- Modal mot de passe rapide (compte mémorisé) -->
  <div class="quick-pwd-modal" id="quick-pwd-modal">
    <div class="quick-pwd-card">
      <h3 id="quick-email-label">Connexion rapide</h3>
      <p>Entrez le mot de passe pour ce compte</p>
      <div class="pwd-wrap">
        <input type="password" id="quick-pwd" class="inp" placeholder="••••••••" autocomplete="current-password" />
      </div>
      <div class="quick-err" id="quick-err"></div>
      <button class="btn-submit" id="quick-submit" onclick="submitQuick()" style="margin-top:14px;">
        Se connecter
      </button>
      <button onclick="closeQuickModal()"
        style="width:100%;margin-top:8px;padding:10px;background:none;border:none;color:#475569;cursor:pointer;font-size:13px;">
        Annuler
      </button>
    </div>
  </div>

  <form method="POST" action="/login" id="quick-form" style="display:none;">
    <input type="hidden" name="username" id="quick-username-field" />
    <input type="hidden" name="password" id="quick-password-field" />
    <input type="hidden" name="redirect" value="<%= locals.redirectTo || '' %>" />
  </form>

  <script>
    let _quickEmail = '';

    // ── Supprimer un compte récent ──────────────────────────────────────────
    async function deleteKnown(event, email) {
      event.stopPropagation(); // ne pas ouvrir la modal de connexion
      const id = 'known-' + email.replace(/[@.+]/g, '-');
      const el = document.getElementById(id);
      if (!el) return;

      // Animation de disparition
      el.style.transition = 'opacity .2s, transform .2s';
      el.style.opacity = '0';
      el.style.transform = 'translateX(12px)';

      try {
        await fetch('/api/remove-known-account', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
          body: JSON.stringify({ email }),
        });
      } catch (e) { /* silencieux */ }

      setTimeout(() => {
        el.remove();
        // Cacher toute la section si plus aucun compte
        const list = document.querySelector('.known-list');
        if (list && list.children.length === 0) {
          document.querySelector('.known-accounts')?.remove();
        }
      }, 200);
    }

    function selectKnown(email) {
      _quickEmail = email;
      // Extraire le nom d'utilisateur (avant @)
      const username = email.includes('@') ? email.split('@')[0] : email;
      document.getElementById('quick-email-label').textContent = email;
      document.getElementById('quick-pwd').value = '';
      document.getElementById('quick-err').style.display = 'none';
      document.getElementById('quick-pwd-modal').classList.add('open');
      setTimeout(() => document.getElementById('quick-pwd').focus(), 80);
    }

    function closeQuickModal() {
      document.getElementById('quick-pwd-modal').classList.remove('open');
      _quickEmail = '';
    }

    // ── Mot de passe oublié ──────────────────────────────────────────────
    let _forgotEmail = '';

    function openForgotPassword() {
      document.getElementById('forgot-step-email').style.display = 'block';
      document.getElementById('forgot-step-reset').style.display = 'none';
      document.getElementById('forgot-email').value = '';
      document.getElementById('forgot-email-err').style.display = 'none';
      document.getElementById('forgot-modal').classList.add('open');
      setTimeout(() => document.getElementById('forgot-email').focus(), 80);
    }

    function closeForgotPassword() {
      document.getElementById('forgot-modal').classList.remove('open');
    }

    async function submitForgotEmail() {
      let email = document.getElementById('forgot-email').value.trim();
      if (!email) { showForgotErr('forgot-email-err', 'Adresse email requise'); return; }
      if (!email.includes('@')) email = email + '@netiify.cloud';
      _forgotEmail = email;

      const btn = document.getElementById('forgot-email-submit');
      btn.disabled = true; btn.textContent = 'Envoi…';

      try {
        const r = await fetch('/api/auth/forgot-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        const data = await r.json();
        btn.disabled = false; btn.textContent = 'Envoyer le code';

        if (!data.ok) { showForgotErr('forgot-email-err', data.error || 'Erreur'); return; }

        document.getElementById('forgot-step-email').style.display = 'none';
        document.getElementById('forgot-step-reset').style.display = 'block';
        document.getElementById('forgot-code').focus();
      } catch (e) {
        btn.disabled = false; btn.textContent = 'Envoyer le code';
        showForgotErr('forgot-email-err', 'Erreur réseau');
      }
    }

    async function submitForgotReset() {
      const code = document.getElementById('forgot-code').value.trim();
      const newPassword = document.getElementById('forgot-newpwd').value;
      const confirmPassword = document.getElementById('forgot-newpwd2').value;

      if (!code) { showForgotErr('forgot-reset-err', 'Code requis'); return; }
      if (!newPassword || newPassword.length < 8) { showForgotErr('forgot-reset-err', 'Le mot de passe doit contenir au moins 8 caractères'); return; }
      if (newPassword !== confirmPassword) { showForgotErr('forgot-reset-err', 'Les mots de passe ne correspondent pas'); return; }

      const btn = document.getElementById('forgot-reset-submit');
      btn.disabled = true; btn.textContent = 'Réinitialisation…';

      try {
        const r = await fetch('/api/auth/reset-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: _forgotEmail, code, newPassword, confirmPassword }),
        });
        const data = await r.json();
        btn.disabled = false; btn.textContent = 'Réinitialiser le mot de passe';

        if (!data.ok) { showForgotErr('forgot-reset-err', data.error || 'Erreur'); return; }

        closeForgotPassword();
        alert('Mot de passe réinitialisé — vous pouvez vous connecter.');
      } catch (e) {
        btn.disabled = false; btn.textContent = 'Réinitialiser le mot de passe';
        showForgotErr('forgot-reset-err', 'Erreur réseau');
      }
    }

    function showForgotErr(id, msg) {
      const el = document.getElementById(id);
      el.textContent = msg;
      el.style.display = 'block';
    }

    document.getElementById('forgot-modal').addEventListener('click', (e) => {
      if (e.target === document.getElementById('forgot-modal')) closeForgotPassword();
    });

    function submitQuick() {
      const pwd = document.getElementById('quick-pwd').value;
      if (!pwd) { document.getElementById('quick-err').textContent = 'Mot de passe requis'; document.getElementById('quick-err').style.display = 'block'; return; }
      const btn = document.getElementById('quick-submit');
      btn.disabled = true;
      btn.innerHTML = '<svg class="spin" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> Connexion…';
      document.getElementById('quick-username-field').value = _quickEmail;
      document.getElementById('quick-password-field').value = pwd;
      document.getElementById('quick-form').submit();
    }

    // Enter dans le champ mot de passe rapide
    document.getElementById('quick-pwd').addEventListener('keydown', (e) => {
      if (e.key === 'Enter') submitQuick();
      if (e.key === 'Escape') closeQuickModal();
    });

    // Fermer modal en cliquant dehors
    document.getElementById('quick-pwd-modal').addEventListener('click', (e) => {
      if (e.target === document.getElementById('quick-pwd-modal')) closeQuickModal();
    });

    function togglePwd() {
      const inp = document.getElementById('password');
      const open = document.getElementById('eye-open');
      const close = document.getElementById('eye-close');
      if (inp.type === 'password') {
        inp.type = 'text'; open.style.display = 'none'; close.style.display = 'block';
      } else {
        inp.type = 'password'; open.style.display = 'block'; close.style.display = 'none';
      }
    }

    document.getElementById('login-form')?.addEventListener('submit', () => {
      const btn = document.getElementById('submit-btn');
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = `<svg class="spin" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> Connexion…`;
      }
    });

    document.getElementById('twofa-form')?.addEventListener('submit', () => {
      const inp = document.getElementById('twofa-token');
      if (inp) inp.disabled = false; // laisser la valeur partir avec le POST
    });

    document.getElementById('username')?.focus();
    document.getElementById('twofa-token')?.focus();
  </script>
</body>

</html>