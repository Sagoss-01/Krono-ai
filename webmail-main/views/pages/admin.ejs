<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= title %></title>
  <meta name="csrf-token" content="<%= csrfToken || '' %>">
  <link rel="stylesheet" href="/css/style.css"/>
  <link rel="stylesheet" href="/css/mail.css"/>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
  <style>
    body { background: var(--bg-base, var(--bg-main)); color: var(--text-1); font-family: 'Sora', sans-serif; margin: 0; }
    .adm-page { max-width: 1100px; margin: 0 auto; padding: 28px 24px 80px; }
    .adm-back { display: inline-flex; align-items: center; gap: 8px; color: var(--text-muted); text-decoration: none; font-size: 13px;
      margin-bottom: 24px; padding: 6px 12px; border-radius: 8px; background: var(--bg-card); border: 1px solid var(--border); }
    .adm-back:hover { color: var(--accent); border-color: var(--accent); }
    .adm-title { font-size: 24px; font-weight: 800; margin: 0 0 20px; display:flex; align-items:center; gap:10px; }

    .adm-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; margin-bottom: 28px; }
    .adm-stat-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 14px; padding: 16px 18px; }
    .adm-stat-value { font-size: 26px; font-weight: 800; color: var(--accent); }
    .adm-stat-label { font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: .04em; margin-top: 4px; }

    .adm-tabs { display: flex; gap: 4px; margin-bottom: 16px; border-bottom: 1px solid var(--border); }
    .adm-tab { padding: 9px 16px; border: none; background: transparent; color: var(--text-muted); font-size: 13px; font-weight: 700;
      cursor: pointer; font-family: 'Sora', sans-serif; border-bottom: 2px solid transparent; }
    .adm-tab.active { color: var(--accent); border-bottom-color: var(--accent); }

    .adm-table-wrap { background: var(--bg-card); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; }
    table.adm-table { width: 100%; border-collapse: collapse; font-size: 12px; }
    table.adm-table th { text-align: left; padding: 10px 14px; color: var(--text-muted); font-weight: 700; text-transform: uppercase;
      font-size: 10px; border-bottom: 1px solid var(--border); background: var(--bg-panel); }
    table.adm-table td { padding: 10px 14px; border-bottom: 1px solid var(--border); color: var(--text-1); }
    table.adm-table tr:last-child td { border-bottom: none; }
    .adm-badge { display: inline-block; padding: 2px 8px; border-radius: 20px; font-size: 10px; font-weight: 700; }
    .adm-badge.live { background: rgba(34,197,94,.15); color: #22c55e; }
    .adm-badge.scheduled { background: rgba(3,92,128,.2); color: #7dd3fc; }
    .adm-badge.ok { background: rgba(34,197,94,.15); color: #22c55e; }
    .adm-badge.fail { background: rgba(248,113,113,.15); color: #f87171; }
    .adm-empty { padding: 30px; text-align: center; color: var(--text-muted); font-size: 12px; }
  </style>
</head>
<body>
  <div class="adm-page">
    <a href="/mail" class="adm-back">← Retour au webmail</a>
    <div class="adm-title">🛡️ Administration</div>

    <div class="adm-stats" id="adm-stats">
      <div class="adm-stat-card"><div class="adm-stat-value">…</div><div class="adm-stat-label">Chargement</div></div>
    </div>

    <div class="adm-tabs">
      <button class="adm-tab active" id="adm-tab-activity" onclick="Admin.showTab('activity')">Activité récente</button>
      <button class="adm-tab" id="adm-tab-accounts" onclick="Admin.showTab('accounts')">Comptes</button>
      <button class="adm-tab" id="adm-tab-meetings" onclick="Admin.showTab('meetings')">Réunions en cours</button>
    </div>

    <div class="adm-table-wrap">
      <div id="adm-panel-activity"></div>
      <div id="adm-panel-accounts" style="display:none;"></div>
      <div id="adm-panel-meetings" style="display:none;"></div>
    </div>
  </div>

  <script src="/js/admin.js"></script>
</body>
</html>
