<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <meta name="csrf-token" content="<%= csrfToken || '' %>">
  <link rel="icon" href="/favicon.ico" type="image/x-icon" />
  <link rel="stylesheet" href="/css/style.css" />
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    * { box-sizing: border-box; font-family: 'Sora', sans-serif; }
    body { margin: 0; background: #060d1a; color: #f1f5f9; min-height: 100vh; }
    .wrap { max-width: 440px; margin: 0 auto; padding: 32px 20px 80px; text-align: center; }
    .topbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 26px; text-align: left; }
    .topbar h1 { font-size: 20px; margin: 0; }
    .topbar a.back { color: #7dd3fc; text-decoration: none; font-size: 13px; }
    .card { background: #0f172a; border: 1px solid rgba(3,92,128,.18); border-radius: 18px; padding: 28px; }
    .qr-box { width: 240px; height: 240px; margin: 0 auto 18px; background: #fff; border-radius: 14px; display: flex; align-items: center; justify-content: center; overflow: hidden; }
    .qr-box img { width: 100%; height: 100%; }
    p.desc { font-size: 12px; color: #94a3b8; line-height: 1.6; margin: 0 0 16px; }
    .timer { font-size: 12px; color: #f59e0b; font-weight: 700; margin-bottom: 14px; }
    .link-row { display: flex; gap: 6px; margin-top: 10px; }
    .link-row input { flex: 1; padding: 9px 10px; border-radius: 8px; border: 1px solid rgba(3,92,128,.25); background: #111c31; color: #94a3b8; font-size: 11px; }
    .btn { padding: 10px 16px; border-radius: 9px; border: none; background: linear-gradient(135deg,#035c80,#024a6a); color: #fff; font-size: 12px; font-weight: 700; cursor: pointer; }
    .status { margin-top: 16px; font-size: 13px; padding: 10px; border-radius: 10px; display:none; }
    .status.ok { display:block; background: rgba(34,197,94,.12); color: #86efac; }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="topbar">
      <h1>⚡ Connexion rapide</h1>
      <a class="back" href="/mail">&larr; Retour</a>
    </div>
    <div class="card">
      <div id="qr-container" class="qr-box"><span style="color:#333;font-size:12px;">Génération…</span></div>
      <p class="desc">
        Ouvre l'appareil photo de ton téléphone (ou un autre navigateur) et scanne ce code
        pour t'y connecter instantanément, sans mot de passe.
      </p>
      <div class="timer" id="qc-timer"></div>
      <div class="link-row">
        <input type="text" id="qc-link" readonly>
        <button class="btn" onclick="QuickConnect.copyLink()">Copier</button>
      </div>
      <div id="qc-status" class="status"></div>
    </div>
    <p style="margin-top:16px;"><a href="/quick-connect/new-device" target="_blank" rel="noopener noreferrer" style="font-size:12px;color:#7dd3fc;text-decoration:none;">Connecter un nouvel appareil qui n'est pas encore connecté &rarr;</a></p>
  </div>

  <script>
    const QuickConnect = (() => {
      let currentToken = null, pollTimer = null, countdownTimer = null;

      function getCsrfToken() {
        return document.querySelector('meta[name="csrf-token"]')?.content || '';
      }

      async function generate() {
        clearInterval(pollTimer); clearInterval(countdownTimer);
        const res = await fetch('/api/quick-connect/generate', {
          method: 'POST',
          headers: { 'X-CSRF-Token': getCsrfToken() }
        }).then(r => r.json());

        if (!res.ok) { document.getElementById('qr-container').innerHTML = '<span style="color:#c00;font-size:11px;padding:10px;">Erreur</span>'; return; }

        currentToken = res.token;
        document.getElementById('qr-container').innerHTML = `<img src="${res.qrDataUrl}" alt="QR code">`;
        document.getElementById('qc-link').value = res.url;
        document.getElementById('qc-status').className = 'status';

        startCountdown(new Date(res.expiresAt));
        pollTimer = setInterval(checkStatus, 2000);
      }

      function startCountdown(expiresAt) {
        const el = document.getElementById('qc-timer');
        countdownTimer = setInterval(() => {
          const s = Math.max(0, Math.round((expiresAt - Date.now()) / 1000));
          el.textContent = s > 0 ? `Expire dans ${s}s` : 'Expiré — régénération…';
          if (s <= 0) { clearInterval(countdownTimer); generate(); }
        }, 500);
      }

      async function checkStatus() {
        if (!currentToken) return;
        const res = await fetch('/api/quick-connect/status/' + currentToken).then(r => r.json());
        if (res.status === 'used') {
          clearInterval(pollTimer); clearInterval(countdownTimer);
          const statusEl = document.getElementById('qc-status');
          statusEl.className = 'status ok';
          statusEl.textContent = '✅ Un appareil vient de se connecter avec ce code !';
        }
      }

      function copyLink() {
        const input = document.getElementById('qc-link');
        input.select();
        navigator.clipboard?.writeText(input.value);
      }

      document.addEventListener('DOMContentLoaded', generate);
      return { copyLink };
    })();
  </script>
</body>
</html>
