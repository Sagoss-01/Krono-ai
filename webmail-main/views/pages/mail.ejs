<style>
/* ── Actions boutons mobile ─────────────────────────── */
@media (max-width: 768px) {
  /* Cacher les boutons secondaires sur mobile */
  .desktop-action { display: none !important; }

  /* Afficher les éléments mobile-only */
  .mobile-only { display: flex !important; }
}
@media (min-width: 769px) {
  /* Cacher les éléments mobile-only sur desktop */
  .mobile-only { display: none !important; }
}

/* Menu "Plus" — wrapper positionné */
.more-actions-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

/* Dropdown "Plus" */
.more-actions-menu {
  position: absolute;
  top: calc(100% + 6px);
  right: 0;
  z-index: 500;
  background: var(--bg-panel);
  border: 1px solid var(--border);
  border-radius: 12px;
  box-shadow: 0 12px 32px rgba(0,0,0,0.35);
  min-width: 190px;
  overflow: hidden;
  animation: fadeUp .15s ease;
}

.more-action-item {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  padding: 10px 14px;
  background: none;
  border: none;
  color: var(--text-2);
  font-size: 13px;
  font-family: 'Sora', sans-serif;
  cursor: pointer;
  text-align: left;
  transition: background .1s;
}
.more-action-item:hover {
  background: var(--bg-hover);
  color: var(--accent);
}
.more-action-item svg {
  flex-shrink: 0;
  color: var(--text-3);
}
</style>

<script>
/* MailUI — toggle menu "Plus" sur mobile */
var MailUI = MailUI || {};
MailUI.toggleMoreMenu = function() {
  var menu = document.getElementById('more-actions-menu');
  if (!menu) return;
  var isOpen = menu.style.display !== 'none';
  menu.style.display = isOpen ? 'none' : 'block';
  // Fermer en cliquant ailleurs
  if (!isOpen) {
    setTimeout(function() {
      document.addEventListener('click', function handler(e) {
        var wrap = document.getElementById('more-actions-wrap');
        if (wrap && !wrap.contains(e.target)) {
          menu.style.display = 'none';
          document.removeEventListener('click', handler);
        }
      });
    }, 0);
  }
};

/* MailUI.patchMailLinks — force l'ouverture de tous les liens du corps du mail
   dans un nouvel onglet, quelle que soit la façon dont ils ont été insérés
   (compatible avec les liens ajoutés dynamiquement par sanitizeHtml). */
MailUI.patchMailLinks = function() {
  var bodyEl = document.getElementById('v-body');
  if (!bodyEl) return;
  var links = bodyEl.querySelectorAll('a[href]');
  links.forEach(function(a) {
    var href = a.getAttribute('href') || '';
    // On ne touche pas aux ancres internes qui doivent rester normales
    if (href.startsWith('#')) return;
    a.setAttribute('target', '_blank');
    // rel="noopener noreferrer" : évite qu'une page ouverte dans l'onglet
    // puisse manipuler la fenêtre d'origine (sécurité) et masque le referrer
    a.setAttribute('rel', 'noopener noreferrer');
  });
};
</script>

